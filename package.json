{
  "name": "seker-platform",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:start": "pnpm --filter @seker/db exec supabase start",
    "db:stop": "pnpm --filter @seker/db exec supabase stop"
  },
  "pnpm": {
    "overrides": { "sharp": "0.35.5" }
  },
  "devDependencies": {
    "turbo": "2.11.8"
  }
}
