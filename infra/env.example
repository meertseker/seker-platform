# /opt/seker/.env — sahibi deploy, chmod 600. Bu dosya git'e girmez; yalnızca bu örnek girer.
# --- compose ---
GHCR_OWNER=meertseker
IMAGE_TAG=
SITE_HOST=sekeranaokulu.com
PANEL_HOST=panel.sekeranaokulu.com
ACME_EMAIL=meertseker@gmail.com

# --- ortak ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# web ve panel kullanır, yalnızca sunucu
SUPABASE_SECRET_KEY=
AUTH_COOKIE_DOMAIN=.sekeranaokulu.com
SITE_URL=https://sekeranaokulu.com
PANEL_URL=https://panel.sekeranaokulu.com
CRON_SECRET=

# --- web ---
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=sekerakademi@gmail.com
LEAD_FROM_EMAIL=
# Derleme zamanı değerleri: GitHub → Settings → Variables'tan gelir, sunucu .env'inde etkisiz
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_TAG_ID=AW-18516861263
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_PANEL_URL=https://panel.sekeranaokulu.com
NEXT_PUBLIC_MEDIA_BASE_URL=
# Meta pikseli ve onay metni sürümü (GitHub Variables). Boşsa piksel yok, onay metni v1.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CONSENT_VERSION=

# --- S3 ---
# S3_BUCKET, infra/aws IAM/bucket politikasındaki kova ile aynı olmalı (sekeranaokulu-media)
S3_REGION=eu-central-1
S3_BUCKET=sekeranaokulu-media
MEDIA_AWS_ACCESS_KEY_ID=
MEDIA_AWS_SECRET_ACCESS_KEY=
S3_BACKUP_BUCKET=sekeranaokulu-backup
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=

# --- cron ---
SUPABASE_DB_URL=
HC_BACKUP_URL=
HC_CRON_DAILY_URL=

# --- Google Ads (bos birakilirsa ozellik kapali kalir) ---
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION_RANDEVU=
GOOGLE_ADS_CONVERSION_ACTION_KAYIT=

# --- WhatsApp grubu (WAHA). Boşsa özellik kapalı. Anahtar: openssl rand -hex 32 ---
WAHA_URL=http://waha:3000
WAHA_API_KEY=

# --- Google Analytics 4 (panel raporu; OAuth = yukaridaki GOOGLE_ADS_* istemcisi, analytics.readonly kapsamiyla) ---
GA4_PROPERTY_ID=

# --- Claude API: Görev ver ekraninin AI konu onerileri. Bossa oneriler kapali, gorev elle verilir. ---
ANTHROPIC_API_KEY=
# Bos birakilirsa claude-sonnet-5-5
ANTHROPIC_MODEL=

# --- Meta (Instagram) reklamlari. Bos birakilirsa ozellik kapali kalir (docs/pazarlama-kurulum.md) ---
META_ACCESS_TOKEN=
META_APP_SECRET=
META_AD_ACCOUNT_ID=
META_INSTAGRAM_USER_ID=
META_PIXEL_ID=
# Test haftasinda Olay Yoneticisi kodu; sonra bos
META_CAPI_TEST_CODE=
# Yalniz "true" iken Conversions API gonderir
META_CAPI_ENABLED=
# Bossa https://yeni.sekeranaokulu.com
SITE_PUBLIC_URL=

# --- Reklam yonetimi ve icerik ---
# Yalniz "true" iken panel Google/Meta'da butce ve durum degistirir; yoksa yalniz kaydeder
ADS_WRITE_ENABLED=
# Ogretmen video siniri (MB); bossa 50
CONTENT_VIDEO_MAX_MB=

# --- Reklam sayfasi yeniden dogrulama (panel yayinlayinca web /api/revalidate cagirir) ---
# web ile panel ayni deger; openssl rand -hex 32
WEB_REVALIDATE_SECRET=
