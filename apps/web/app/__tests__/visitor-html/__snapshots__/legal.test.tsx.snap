exports[`yasal sayfalar ziyaretçi HTML > cerez: düzenleme katmanından önceki hâliyle aynı 1`] = `"<div class="min-h-screen bg-paper"><div class="py-16"><div class="container mx-auto px-4 md:px-6"><div class="max-w-4xl mx-auto"><h1 class="mb-8 font-display text-3xl text-ink md:text-4xl">Çerez Politikası</h1><div class="prose prose-lg"><p class="mb-6 text-ink-soft">Bu sayfa şu anda hazırlanmaktadır. Çerez politikamız hakkında bilgi almak için bizimle iletişime geçebilirsiniz.</p><a href="/iletisim" class="inline-block rounded-full bg-grape px-6 py-3 font-semibold text-white shadow-lg shadow-grape/30 transition-colors duration-200 hover:bg-ink">İletişim</a></div></div></div></div></div>"`;

exports[`yasal sayfalar ziyaretçi HTML > gizlilik: düzenleme katmanından önceki hâliyle aynı 1`] = `"<div class="min-h-screen bg-paper"><div class="py-16"><div class="container mx-auto px-4 md:px-6"><article class="mx-auto max-w-3xl"><h1 class="mb-2 font-display text-3xl text-ink md:text-4xl">KVKK Aydınlatma Metni</h1><p class="mb-10 text-sm text-ink-soft">Son güncelleme: [OKULDAN TEYİT ALINACAK: yayın tarihi, ör. 1 Kasım 2026]</p><div class="space-y-10"><section id="veri-sorumlusu" class="space-y-3"><h2 class="font-display text-xl text-ink md:text-2xl">Veri sorumlusu</h2><p class="leading-relaxed text-ink-soft">6698 sayılı Kişisel Verilerin Korunması Kanunu ("KVKK") kapsamında veri sorumlusu Özel Şeker Anaokulu'dur ([OKULDAN TEYİT ALINACAK: tam ticari unvan / işleten gerçek veya tüzel kişi, MERSİS veya vergi no]). Adres: Cumhuriyet Mahallesi, Uludağ Sokak No:6, Beykent, Büyükçekmece, İstanbul. E-posta: sekerakademi@gmail.com. Telefon: 0530 101 88 75.</p></section><section id="veriler" class="space-y-3"><h2 class="font-display text-xl text-ink md:text-2xl">Hangi kişisel verileri işliyoruz</h2><p class="leading-relaxed text-ink-soft">Web sitemizdeki ön görüşme formu ve reklam sayfalarımız aracılığıyla şu verileri işliyoruz:</p><ul class="list-disc space-y-2 pl-6 text-ink-soft"><li>Kimlik ve iletişim: velinin adı soyadı ve telefon numarası.</li><li>Başvuru bilgisi: formun doldurulduğu sayfa, tarih ve saat, onay kaydı.</li><li>Reklam ve pazarlama bilgisi: bir Google reklamına tıklayarak geldiyseniz reklam tıklama kimliği (gclid) ve kampanya bilgisi (UTM parametreleri).</li><li>Görüşme süreci: sizinle yaptığımız görüşme, randevu ve kayıt aşamalarına ilişkin notlar.</li></ul></section><section id="amaclar" class="space-y-3"><h2 class="font-display text-xl text-ink md:text-2xl">Verilerinizi hangi amaçlarla işliyoruz</h2><ul class="list-disc space-y-2 pl-6 text-ink-soft"><li>Başvurunuza dönüş yapmak, sizi aramak, WhatsApp üzerinden yazmak ve okul ziyareti randevusu oluşturmak.</li><li>Kayıt sürecini yürütmek ve kayıt olmanız halinde sözleşme ilişkisini kurmak.</li><li>Hangi reklam ve sayfaların başvuru ve kayıt getirdiğini ölçmek; bu amaçla başvurunuzun bir randevuya veya kayda dönüştüğü bilgisini, reklam tıklama kimliğiyle birlikte Google'a bildirmek.</li><li>Yasal yükümlülüklerimizi yerine getirmek ve olası uyuşmazlıklarda hakkımızı korumak.</li></ul></section><section id="hukuki-sebep" class="space-y-3"><h2 class="font-display text-xl text-ink md:text-2xl">Hukuki sebepler</h2><p class="leading-relaxed text-ink-soft">Başvurunuza dönüş yapılması ve kayıt süreci, KVKK md. 5/2-(c) uyarınca bir sözleşmenin kurulmasıyla doğrudan ilgili olması ve md. 5/2-(f) uyarınca meşru menfaatimiz hukuki sebeplerine dayanır.</p><p class="leading-relaxed text-ink-soft">Başvuru ve kayıt bilgisinin reklam ölçümü amacıyla Google ile paylaşılması ve bu kapsamda yurt dışına aktarılması, formda verdiğiniz açık rızaya (KVKK md. 5/1 ve md. 9) dayanır.</p></section><section id="aktarim" class="space-y-3"><h2 class="font-display text-xl text-ink md:text-2xl">Verilerinizi kimlerle paylaşıyoruz</h2><p class="leading-relaxed text-ink-soft">Verilerinizi satmıyoruz. Yalnızca hizmeti yürütmek için aşağıdaki hizmet sağlayıcılarla, bu amaçla sınırlı olarak paylaşıyoruz. Bu sağlayıcıların sunucuları yurt dışındadır; aktarım KVKK md. 9 kapsamında açık rızanıza ve/veya Kurul'un öngördüğü standart sözleşmelere dayanır.</p><ul class="list-disc space-y-2 pl-6 text-ink-soft"><li>Google (Google Ads, Google Tag Manager): reklam ölçümü; başvurunuzun randevu veya kayda dönüştüğü bilgisi reklam tıklama kimliğiyle birlikte bildirilir. Ad ve telefon numaranız Google Ads'e gönderilmez; reklam ölçümü için yalnızca tıklama kimliği ve kampanya bilgisi paylaşılır.</li><li>Supabase: başvuru ve kayıt bilgilerinin saklandığı veritabanı (Avrupa Birliği, Frankfurt [OKULDAN TEYİT ALINACAK: Supabase proje bölgesi]).</li><li>Amazon Web Services: web sitesi ve okul yönetim panelinin çalıştığı sunucu ve yedekler (Avrupa Birliği, Frankfurt).</li><li>Resend: yeni başvuru bildiriminin okul yönetimine e-posta ile iletilmesi (ABD).</li><li>Google (Gmail / Google Workspace): başvuru bildirim e-postalarının okul yönetiminin gelen kutusunda alınması; e-postada adınız ve telefon numaranız yer alır (e-posta hizmeti, yurt dışı).</li><li>Yetkili kamu kurum ve kuruluşları: yalnızca hukuken zorunlu olduğunda.</li></ul></section><section id="toplama" class="space-y-3"><h2 class="font-display text-xl text-ink md:text-2xl">Toplama yöntemi</h2><p class="leading-relaxed text-ink-soft">Verileriniz web sitemizdeki form aracılığıyla elektronik ortamda, otomatik yollarla toplanır. Reklam tıklama kimliği, Google reklamına tıkladığınızda adres satırında sitemize iletilir.</p></section><section id="saklama" class="space-y-3"><h2 class="font-display text-xl text-ink md:text-2xl">Saklama süresi</h2><p class="leading-relaxed text-ink-soft">Kayıtla sonuçlanmayan başvurular [OKULDAN TEYİT ALINACAK: süre, ör. 2 yıl] sonra silinir veya anonim hale getirilir. Kayıt olan öğrencilere ilişkin veriler sözleşme süresi ve ilgili mevzuattaki saklama süreleri boyunca tutulur. Yedeklerdeki kopyalar en geç 30 gün içinde kendiliğinden silinir.</p></section><section id="haklar" class="space-y-3"><h2 class="font-display text-xl text-ink md:text-2xl">KVKK md. 11 kapsamındaki haklarınız</h2><p class="leading-relaxed text-ink-soft">Bize başvurarak:</p><ul class="list-disc space-y-2 pl-6 text-ink-soft"><li>Kişisel verinizin işlenip işlenmediğini öğrenme,</li><li>İşlenmişse buna ilişkin bilgi talep etme,</li><li>İşlenme amacını ve amacına uygun kullanılıp kullanılmadığını öğrenme,</li><li>Yurt içinde veya yurt dışında aktarıldığı üçüncü kişileri bilme,</li><li>Eksik veya yanlış işlenmişse düzeltilmesini isteme,</li><li>KVKK md. 7 şartları çerçevesinde silinmesini veya yok edilmesini isteme,</li><li>Düzeltme ve silme işlemlerinin aktarıldığı üçüncü kişilere bildirilmesini isteme,</li><li>Münhasıran otomatik sistemlerle analiz edilmesi sonucu aleyhinize bir sonuç çıkmasına itiraz etme,</li><li>Kanuna aykırı işleme sebebiyle zarara uğramanız halinde zararın giderilmesini talep etme</li></ul></section><section id="basvuru" class="space-y-3"><h2 class="font-display text-xl text-ink md:text-2xl">Başvuru ve rızanın geri alınması</h2><p class="leading-relaxed text-ink-soft">Haklarınıza ilişkin taleplerinizi sekerakademi@gmail.com adresine e-posta ile veya Cumhuriyet Mahallesi, Uludağ Sokak No:6, Beykent, Büyükçekmece, İstanbul adresine yazılı olarak iletebilirsiniz. Talebiniz en geç 30 gün içinde ücretsiz olarak sonuçlandırılır.</p><p class="leading-relaxed text-ink-soft">Google ile reklam ölçümü paylaşımına verdiğiniz açık rızayı aynı yollarla dilediğiniz zaman geri alabilirsiniz; geri alma, o tarihten sonraki paylaşımları durdurur.</p></section></div></article></div></div></div>"`;

exports[`yasal sayfalar ziyaretçi HTML > kullanim: düzenleme katmanından önceki hâliyle aynı 1`] = `"<div class="min-h-screen bg-paper"><div class="py-16"><div class="container mx-auto px-4 md:px-6"><div class="max-w-4xl mx-auto"><h1 class="mb-8 font-display text-3xl text-ink md:text-4xl">Kullanım Şartları</h1><div class="prose prose-lg"><p class="mb-6 text-ink-soft">Bu sayfa şu anda hazırlanmaktadır. Kullanım şartlarımız hakkında bilgi almak için bizimle iletişime geçebilirsiniz.</p><a href="/iletisim" class="inline-block rounded-full bg-grape px-6 py-3 font-semibold text-white shadow-lg shadow-grape/30 transition-colors duration-200 hover:bg-ink">İletişim</a></div></div></div></div></div>"`;
