(--color-rule)" stroke-width="1.2"></circle><circle data-mark="limit" cx="38" cy="8" r="5.4" fill="none" stroke="var(--color-rule)" stroke-width="1.2"></circle><circle data-mark="limit" cx="53" cy="8" r="5.4" fill="none" stroke="var(--color-rule)" stroke-width="1.2"></circle><circle data-mark="limit" cx="68" cy="8" r="5.4" fill="none" stroke="var(--color-rule)" stroke-width="1.2"></circle><circle data-mark="limit" cx="83" cy="8" r="5.4" fill="none" stroke="var(--color-rule)" stroke-width="1.2"></circle><circle data-mark="limit" cx="98" cy="8" r="5.4" fill="none" stroke="var(--color-rule)" stroke-width="1.2"></circle><circle data-mark="limit" cx="113" cy="8" r="5.4" fill="none" stroke="var(--color-rule)" stroke-width="1.2"></circle><circle data-mark="limit" cx="128" cy="8" r="5.4" fill="none" stroke="var(--color-rule)" stroke-width="1.2"></circle><circle data-mark="limit" cx="143" cy="8" r="5.4" fill="none" stroke="var(--color-rule)" stroke-width="1.2"></circle><circle data-mark="limit" cx="8" cy="26" r="5.4" fill="none" stroke="var(--color-rule)" stroke-width="1.2"></circle><circle data-mark="limit" cx="23" cy="26" r="5.4" fill="none" stroke="var(--color-rule)" stroke-width="1.2"></circle><circle data-mark="limit" cx="38" cy="26" r="5.4" fill="none" stroke="var(--color-rule)" stroke-width="1.2"></circle><circle data-mark="limit" cx="53" cy="26" r="5.4" fill="none" stroke="var(--color-rule)" stroke-width="1.2"></circle><circle data-mark="limit" cx="68" cy="26" r="5.4" fill="none" stroke="var(--color-rule)" stroke-width="1.2"></circle><circle data-mark="limit" cx="83" cy="26" r="5.4" fill="none" stroke="var(--color-rule)" stroke-width="1.2"></circle><circle data-mark="limit" cx="98" cy="26" r="5.4" fill="none" stroke="var(--color-rule)" stroke-width="1.2"></circle><circle data-mark="limit" cx="113" cy="26" r="5.4" fill="none" stroke="var(--color-rule)" stroke-width="1.2"></circle><circle data-mark="limit" cx="128" cy="26" r="5.4" fill="none" stroke="var(--color-rule)" stroke-width="1.2"></circle><circle data-mark="limit" cx="143" cy="26" r="5.4" fill="none" stroke="var(--color-rule)" stroke-width="1.2"></circle></g></svg><figcaption class="mt-3 flex flex-wrap gap-x-5 gap-y-1"><span class="timecode text-ink">13 çocuk, 2 öğretmen</span><span class="timecode text-ink-soft">MEB üst sınırı 20</span></figcaption></figure></div></section><section id="calisma-saati" class="cine-chapter scroll-mt-32 overflow-hidden rounded-3xl bg-white p-6 shadow-sm ring-1 ring-rule md:p-10"><span aria-hidden="true" class="mb-4 block h-1.5 w-14 rounded-full bg-sky"></span><span class="timecode text-grape ">Sahne 03</span><h2 class="mt-3 text-3xl text-ink md:text-4xl">Montessori çalışma saati</h2><p class="mt-3 text-lg text-ink-soft">Çocuk seçer, kendi hızında çalışır; öğretmen gözler.</p><div class="mt-8"><div class="relative w-full overflow-hidden rounded-3xl bg-paper-warm ring-1 ring-rule aspect-[4/5] md:aspect-[2.39/1]" style="view-transition-name: day-calisma-saati;"><img alt="Bahçedeki ahşap mutfak atölyesi, açık hava sınıfı ve ağacı çevreleyen oturma bankı" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; color: transparent;" sizes="(max-width: 768px) 100vw, 1100px" srcset="/_next/image?url=%2Fbahce-atolyeler.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fbahce-atolyeler.webp&amp;w=3840&amp;q=75"><div aria-hidden="true" class="pointer-events-none absolute inset-0 mix-blend-multiply" style="background-color: var(--color-morning); opacity: 0.16;"></div></div></div><div class="mt-8 max-w-2xl"><p class="mt-4 text-ink-soft">Montessori çalışması haftanın beş günü programda. Materyaller açık raflarda, çocuğun boyunda durur: günlük yaşam, duyusal çalışmalar, dil, matematik, dikkat ve konsantrasyon.</p><p class="mt-4 text-ink-soft">Bir çalışmayı seçmek, bitirmek ve yerine kaldırmak çocuğun sorumluluğundadır. Öğretmen araya girmez, izler; bir çocuk takıldığında yanına gider.</p></div></section><section id="ingilizce" class="cine-chapter scroll-mt-32 overflow-hidden rounded-3xl bg-white p-6 shadow-sm ring-1 ring-rule md:p-10"><span aria-hidden="true" class="mb-4 block h-1.5 w-14 rounded-full bg-bubble"></span><span class="timecode text-grape ">Sahne 04</span><h2 class="mt-3 text-3xl text-ink md:text-4xl">İngilizce</h2><p class="mt-3 text-lg text-ink-soft">Haftada birkaç ders değil, her gün aynı saatte.</p><div class="mt-8"><div class="relative w-full overflow-hidden rounded-3xl bg-paper-warm ring-1 ring-rule aspect-[4/5] md:aspect-[2.39/1]" style="view-transition-name: day-ingilizce;"><img alt="Açık hava sınıfında oltayla balık tutma oyunu oynayan çocuk, arkada tamir köşesi" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; color: transparent;" sizes="(max-width: 768px) 100vw, 1100px" srcset="/_next/image?url=%2Facik-hava-sinifi.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Facik-hava-sinifi.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Facik-hava-sinifi.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Facik-hava-sinifi.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Facik-hava-sinifi.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Facik-hava-sinifi.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Facik-hava-sinifi.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Facik-hava-sinifi.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Facik-hava-sinifi.webp&amp;w=3840&amp;q=75"><div aria-hidden="true" class="pointer-events-none absolute inset-0 mix-blend-multiply" style="background-color: var(--color-morning); opacity: 0.16;"></div></div></div><div class="mt-8 max-w-2xl"><p class="mt-4 text-ink-soft">İngilizce çalışmaları oyun, şarkı, hikâye ve günlük iletişimin içinden yürür. Çocuk önce anlar, sonra tek kelimelerle karşılık verir, en sonunda cümle kurar.</p><p class="mt-4 text-ink-soft">English Play Time ve English Kids Club etkinliklerinde dil ders masasından çıkar; Speaking çalışmalarında öğrendiği ifadeleri konuşurken kullanır.</p></div></section><section id="bahce" class="cine-chapter scroll-mt-32 overflow-hidden rounded-3xl bg-white p-6 shadow-sm ring-1 ring-rule md:p-10"><span aria-hidden="true" class="mb-4 block h-1.5 w-14 rounded-full bg-grape"></span><span class="timecode text-grape ">Sahne 05</span><h2 class="mt-3 text-3xl text-ink md:text-4xl">Bahçe</h2><p class="mt-3 text-lg text-ink-soft">İki bahçemiz var; hava elverdiği sürece dışarıdayız.</p><div class="mt-8"><div class="relative w-full overflow-hidden rounded-3xl bg-paper-warm ring-1 ring-rule aspect-[4/5] md:aspect-[2.39/1]" style="view-transition-name: day-bahce;"><img alt="Şeker Anaokulu bahçesi: çim alan, ağaçlar, ahşap oyun evi ve piknik masası" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; color: transparent;" sizes="(max-width: 768px) 100vw, 1100px" srcset="/_next/image?url=%2Fbahce-genis.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fbahce-genis.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fbahce-genis.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fbahce-genis.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fbahce-genis.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fbahce-genis.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fbahce-genis.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fbahce-genis.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fbahce-genis.webp&amp;w=3840&amp;q=75"><div aria-hidden="true" class="pointer-events-none absolute inset-0 mix-blend-multiply" style="background-color: var(--color-midday); opacity: 0.14;"></div></div></div><div class="mt-8 max-w-2xl"><p class="mt-4 text-ink-soft">Bahçe zamanı programın en az müdahale edilen bölümüdür. Çocuklar kendi oyununu kurar, öğretmen gözler ve gerektiğinde araya girer.</p><p class="mt-4 text-ink-soft">Geniş metrekare şunu değiştiriyor: koşmak isteyen çocuk için sıra beklemek gerekmiyor. Bahçeler kapalı ve gözetim altında.</p></div></section><section id="ogle" class="cine-chapter scroll-mt-32 overflow-hidden rounded-3xl bg-white p-6 shadow-sm ring-1 ring-rule md:p-10"><span aria-hidden="true" class="mb-4 block h-1.5 w-14 rounded-full bg-tangerine"></span><span class="timecode text-grape ">Sahne 06</span><h2 class="mt-3 text-3xl text-ink md:text-4xl">Öğle</h2><p class="mt-3 text-lg text-ink-soft">Sofra da bir çalışma alanı.</p><div class="mt-8"><div class="relative w-full overflow-hidden rounded-3xl bg-paper-warm ring-1 ring-rule aspect-[4/5] md:aspect-[2.39/1]" style="view-transition-name: day-ogle;"><img alt="Bahçedeki ahşap oyun mutfağı: tencereler, kepçeler ve &quot;Küçük Şeflerin Mutfağı&quot; yazılı kara tahta" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; color: transparent;" sizes="(max-width: 768px) 100vw, 1100px" srcset="/_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=3840&amp;q=75"><div aria-hidden="true" class="pointer-events-none absolute inset-0 mix-blend-multiply" style="background-color: var(--color-midday); opacity: 0.14;"></div></div></div><div class="mt-8 max-w-2xl"><p class="mt-4 text-ink-soft">Çocuklar kendi tabağını taşır, kendi suyunu koyar, sofrayı birlikte toplar.</p><p class="mt-4 text-ink-soft">Günlük yaşam becerileri ayrı bir ders değil; Montessori çalışmasının sofrada devam eden hâli.</p></div></section><section id="dinlenme" class="cine-chapter scroll-mt-32 overflow-hidden rounded-3xl bg-white p-6 shadow-sm ring-1 ring-rule md:p-10"><span aria-hidden="true" class="mb-4 block h-1.5 w-14 rounded-full bg-sunny"></span><span class="timecode text-grape ">Sahne 07</span><h2 class="mt-3 text-3xl text-ink md:text-4xl">Dinlenme</h2><p class="mt-3 text-lg text-ink-soft">Küçük gruplar dinlenir, büyükler sessiz çalışır.</p><div class="mt-8"><div class="relative w-full overflow-hidden rounded-3xl bg-paper-warm ring-1 ring-rule aspect-[4/5] md:aspect-[2.39/1]" style="view-transition-name: day-dinlenme;"><img alt="Bahçedeki ahşap mutfak atölyesi, açık hava sınıfı ve ağacı çevreleyen oturma bankı" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; color: transparent;" sizes="(max-width: 768px) 100vw, 1100px" srcset="/_next/image?url=%2Fbahce-atolyeler.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fbahce-atolyeler.webp&amp;w=3840&amp;q=75"><div aria-hidden="true" class="pointer-events-none absolute inset-0 mix-blend-multiply" style="background-color: var(--color-midday); opacity: 0.14;"></div></div></div><div class="mt-8 max-w-2xl"><p class="mt-4 text-ink-soft">Küçük yaş gruplarında bu saat dinlenmeye ayrılır. Yarım gün programını seçen çocuklar bu saatte okuldan ayrılır.</p><p class="mt-4 text-ink-soft">Uyumayan gruplar için bu saat sessiz çalışma zamanı: kitap, yapboz, bireysel proje.</p></div></section><section id="atolye" class="cine-chapter scroll-mt-32 overflow-hidden rounded-3xl bg-white p-6 shadow-sm ring-1 ring-rule md:p-10"><span aria-hidden="true" class="mb-4 block h-1.5 w-14 rounded-full bg-mint"></span><span class="timecode text-grape ">Sahne 08</span><h2 class="mt-3 text-3xl text-ink md:text-4xl">Branş dersleri</h2><p class="mt-3 text-lg text-ink-soft">Seramik, robotik, satranç, müzik, dans, drama.</p><div class="mt-8"><div class="relative w-full overflow-hidden rounded-3xl bg-paper-warm ring-1 ring-rule aspect-[4/5] md:aspect-[2.39/1]" style="view-transition-name: day-atolye;"><img alt="Bahçedeki ahşap oyun mutfağı: tencereler, kepçeler ve &quot;Küçük Şeflerin Mutfağı&quot; yazılı kara tahta" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; color: transparent;" sizes="(max-width: 768px) 100vw, 1100px" srcset="/_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=3840&amp;q=75"><div aria-hidden="true" class="pointer-events-none absolute inset-0 mix-blend-multiply" style="background-color: var(--color-golden); opacity: 0.18;"></div></div></div><div class="mt-8 max-w-2xl"><p class="mt-4 text-ink-soft">Branş dersleri eğlence molası değil, programın parçası. Her biri alanında uzman bir öğretmenle yürüyor.</p><p class="mt-4 text-ink-soft">Satranç sırasını beklemeyi ve bir sonraki hamleyi düşünmeyi çalıştırır. Seramik çamuru ve kalem işi el kaslarını yazıya hazırlar. Robotikte çocuk kendi kurduğu robota komut yazar.</p></div></section><section id="cikis" class="cine-chapter scroll-mt-32 overflow-hidden rounded-3xl bg-white p-6 shadow-sm ring-1 ring-rule md:p-10"><span aria-hidden="true" class="mb-4 block h-1.5 w-14 rounded-full bg-sky"></span><span class="timecode text-grape ">Sahne 09</span><h2 class="mt-3 text-3xl text-ink md:text-4xl">Çıkış</h2><p class="mt-3 text-lg text-ink-soft">Günün anlatıldığı an.</p><div class="mt-8"><div class="relative w-full overflow-hidden rounded-3xl bg-paper-warm ring-1 ring-rule aspect-[4/5] md:aspect-[2.39/1]" style="view-transition-name: day-cikis;"><img alt="Şeker Anaokulu yazılı fotoğraf köşesi: kırmızı beyaz çizgili tente ve dev lolipoplar" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; color: transparent;" sizes="(max-width: 768px) 100vw, 1100px" srcset="/_next/image?url=%2Fseker-kosesi.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fseker-kosesi.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fseker-kosesi.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fseker-kosesi.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fseker-kosesi.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fseker-kosesi.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fseker-kosesi.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fseker-kosesi.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fseker-kosesi.webp&amp;w=3840&amp;q=75"><div aria-hidden="true" class="pointer-events-none absolute inset-0 mix-blend-multiply" style="background-color: var(--color-dusk); opacity: 0.26;"></div></div></div><div class="mt-8 max-w-2xl"><p class="mt-4 text-ink-soft">Her çocuk alınırken öğretmeni size o günü anlatır: ne yaptı, neyi zor buldu, neye ilk kez cesaret etti.</p><p class="mt-4 text-ink-soft">Gün içinde merak ettiyseniz kameradan bakmışsınızdır. Çıkışta konuştuğumuz şey, gördüğünüzün arkasındaki hikâye oluyor.</p></div></section><section id="kapanis" class="cine-chapter scroll-mt-32 overflow-hidden rounded-3xl bg-white p-6 shadow-sm ring-1 ring-rule md:p-10"><span aria-hidden="true" class="mb-4 block h-1.5 w-14 rounded-full bg-bubble"></span><span class="timecode text-grape ">Sahne 10</span><h2 class="mt-3 text-3xl text-ink md:text-4xl">Kapanış</h2><p class="mt-3 text-lg text-ink-soft">Son çocuk da alındığında gün biter.</p><div class="mt-8"><div class="relative w-full overflow-hidden rounded-3xl bg-paper-warm ring-1 ring-rule aspect-[4/5] md:aspect-[2.39/1]" style="view-transition-name: day-kapanis;"><img alt="Bahçedeki iki zürafa heykelinin yanında duran çocuklar" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; color: transparent;" sizes="(max-width: 768px) 100vw, 1100px" srcset="/_next/image?url=%2Fzurafalar.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fzurafalar.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fzurafalar.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fzurafalar.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fzurafalar.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fzurafalar.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fzurafalar.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fzurafalar.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fzurafalar.webp&amp;w=3840&amp;q=75"><div aria-hidden="true" class="pointer-events-none absolute inset-0 mix-blend-multiply" style="background-color: var(--color-dusk); opacity: 0.26;"></div></div></div><div class="mt-8 max-w-2xl"><p class="mt-4 text-ink-soft">Geç kalan veliler için telaş yoktur; gün, çalışan ailelerin gerçeğine göre planlanmıştır.</p></div></section></div></div><section class="band-grape relative mt-16 overflow-hidden py-16"><div aria-hidden="true" class="pointer-events-none absolute inset-0"><span class="confetti-float absolute -left-8 top-8 h-32 w-32 rounded-full bg-sunny/15"></span><span class="confetti-float absolute right-[6%] bottom-10 h-24 w-24 rounded-full bg-bubble/20"></span></div><div class="relative z-10 mx-auto max-w-2xl px-6"><h2 class="text-3xl text-white">Bu akışı yerinde görün</h2><p class="mt-4 text-white/85">Bu akış yazıldığı gibi işliyor. Emin olmak isterseniz ders saatinde gelin — randevunuzu sabaha alalım, çalışırken görün.</p><div class="mt-8 rounded-3xl bg-white p-6 shadow-xl shadow-ink/20 md:p-8"><form novalidate="" class="space-y-5"><input readonly="" type="hidden" value="" name="gclid"><input readonly="" type="hidden" value="" name="fbclid"><input readonly="" type="hidden" value="" name="fbc"><input readonly="" type="hidden" value="" name="fbp"><input readonly="" type="hidden" value="/" name="landingPath"><input readonly="" type="hidden" value="" name="utm_source"><input readonly="" type="hidden" value="" name="utm_medium"><input readonly="" type="hidden" value="" name="utm_campaign"><input readonly="" type="hidden" value="" name="utm_term"><input readonly="" type="hidden" value="" name="utm_content"><div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden"><label for="website">Web siteniz</label><input id="website" tabindex="-1" autocomplete="off" type="text" name="website"></div><div class="grid gap-5 md:grid-cols-2"><div><label for="parentName" class="mb-1.5 block text-sm font-semibold text-ink">Adınız</label><input id="parentName" autocomplete="name" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark" required="" name="parentName"></div><div><label for="phone" class="mb-1.5 block text-sm font-semibold text-ink">Telefon numaranız</label><input id="phone" inputmode="tel" autocomplete="tel" placeholder="05XX XXX XX XX" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark" required="" type="tel" name="phone"></div></div><label class="flex items-start gap-3 text-sm text-ink-soft"><input required="" class="mt-1 h-4 w-4" type="checkbox" name="kvkkConsent"><span><a href="/gizlilik" class="underline">KVKK Aydınlatma Metni</a>'ni okudum. Başvurum için aranmama ve başvuru bilgilerimin reklamlarımızın etkinliğini ölçmek amacıyla Google ile paylaşılmasına onay veriyorum.</span></label><button type="submit" class="w-full rounded-full bg-grape px-8 py-4 text-lg font-semibold text-white shadow-lg shadow-grape/30 transition hover:bg-ink disabled:opacity-60">Beni Arayın</button><p class="text-center text-sm text-ink-soft">Numaranızı bırakın, <strong>15 dakika</strong> içinde sizi arayalım.</p></form></div></div></section></main></div>"`;
