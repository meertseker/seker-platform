exports[`reklam sayfaları ziyaretçi HTML > anaokulu-ucret: düzenleme katmanından önceki hâliyle aynı 1`] = `"<div class="bg-paper"><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Neden rakamı sitede yazmıyorsunuz?","acceptedAnswer":{"@type":"Answer","text":"Ücret programa, gün sayısına ve servis ihtiyacına göre değiştiği için tek bir rakam yanıltıcı olur. Ön görüşmede size özel bir hesap paylaşıyoruz."}},{"@type":"Question","name":"Ücrete neler dahil?","acceptedAnswer":{"@type":"Answer","text":"Branş dersleri, günlük İngilizce ve rehberlik desteği programa dahildir; servis ayrıca hesaplanır. Hangi kalemin dahil olduğunu ön görüşmede kalem kalem yazılı paylaşıyoruz."}},{"@type":"Question","name":"Ödeme planı seçebiliyor muyum?","acceptedAnswer":{"@type":"Answer","text":"Ödeme planı, ailenizin ihtiyacına göre ön görüşmede sizinle birlikte belirlenir."}},{"@type":"Question","name":"Ücret ne zaman netleşiyor?","acceptedAnswer":{"@type":"Answer","text":"Ön görüşmede çocuğunuzun yaş grubuna göre net ücreti yazılı paylaşıyoruz."}}]}</script><section><div class="mx-auto max-w-6xl lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,420px)] lg:items-start lg:gap-12 lg:px-6 lg:pt-10 lg:pb-16"><div class="flex min-w-0 flex-col"><div class="relative aspect-[3/2] overflow-hidden bg-paper-warm min-[375px]:aspect-[4/3] lg:order-2 lg:mt-7 lg:aspect-[3/2] lg:rounded-[28px]"><img alt="Şeker Anaokulu bahçesi: çim alan, ağaçlar, ahşap oyun evi ve piknik masası" fetchpriority="high" loading="eager" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; color: transparent;" sizes="(min-width: 1152px) 690px, (min-width: 1024px) 60vw, 100vw" srcset="/_next/image?url=%2Fbahce-genis.webp&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fbahce-genis.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fbahce-genis.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fbahce-genis.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fbahce-genis.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fbahce-genis.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fbahce-genis.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fbahce-genis.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fbahce-genis.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fbahce-genis.webp&amp;w=3840&amp;q=75"><div aria-hidden="true" class="scallop absolute inset-x-0 -bottom-px lg:hidden"></div></div><div class="px-5 pt-4 sm:px-6 lg:order-1 lg:px-0 lg:pt-0"><h1 class="lp-title text-balance text-ink">“Eğitimde Kalite Doğru Yatırımla Başlar.”</h1><p class="lp-lede mt-2.5 max-w-[60ch] whitespace-pre-line text-ink-soft lg:mt-4">Ücret; program, haftalık gün sayısı ve servis ihtiyacına göre değişir. Size özel hesabı, okulu gezdiğiniz ön görüşmede yazılı olarak paylaşıyoruz.</p><a href="#form" class="mt-4 flex min-h-12 items-center justify-center rounded-full bg-grape px-6 text-base font-semibold text-white shadow-md shadow-grape/25 lg:hidden">Ön Görüşme Randevusu</a></div><div class="px-5 sm:px-6 lg:order-3 lg:px-0"><dl class="mt-6 grid grid-cols-3 border-y border-rule py-4 sm:grid-cols-4 lg:mt-7"><div class="min-w-0 border-l border-rule px-3 first:border-l-0 first:pl-0 "><dt class="font-display text-[1.375rem] leading-none font-semibold text-ink lg:text-[1.625rem]">15 yıl</dt><dd class="mt-1.5 text-[13px] leading-snug text-ink-soft">Beykent'te aynı adreste</dd></div><div class="min-w-0 border-l border-rule px-3 first:border-l-0 first:pl-0 "><dt class="font-display text-[1.375rem] leading-none font-semibold text-ink lg:text-[1.625rem]">13</dt><dd class="mt-1.5 text-[13px] leading-snug text-ink-soft">Sınıf mevcudu</dd></div><div class="min-w-0 border-l border-rule px-3 first:border-l-0 first:pl-0 "><dt class="font-display text-[1.375rem] leading-none font-semibold text-ink lg:text-[1.625rem]">1 : 7</dt><dd class="mt-1.5 text-[13px] leading-snug text-ink-soft">Öğretmen başına çocuk</dd></div><div class="min-w-0 border-l border-rule px-3 first:border-l-0 first:pl-0 hidden sm:block"><dt class="font-display text-[1.375rem] leading-none font-semibold text-ink lg:text-[1.625rem]">2-6</dt><dd class="mt-1.5 text-[13px] leading-snug text-ink-soft">Yaş aralığı</dd></div></dl><ul class="mt-6 grid gap-3 lg:mt-7 lg:grid-cols-2 lg:gap-4"><li class="min-w-0"><figure class="h-full rounded-2xl border border-rule bg-white px-4 py-4 lg:px-5"><svg aria-hidden="true" viewBox="0 0 100 20" class="block h-3.5 w-[70px] shrink-0 fill-[#E9A100]"><path transform="translate(0 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(20 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(40 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(60 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(80 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path></svg><blockquote class="mt-2.5 text-[15px] leading-relaxed text-ink">“Şu an 4 yaşında olan kızımız için 1,5 yıl içinde 3 farklı yer denedik. Daha köklü ve iyi olur diye kolej anaokuluna bile gönderdik. Sonunda burada karar kıldık.”</blockquote><figcaption class="mt-3 text-[13px] leading-snug text-ink-soft"><span class="font-bold text-ink">Emre</span><span class="block">Google yorumu · 4 yaş velisi</span></figcaption></figure></li><li class="min-w-0"><figure class="h-full rounded-2xl border border-rule bg-white px-4 py-4 lg:px-5"><svg aria-hidden="true" viewBox="0 0 100 20" class="block h-3.5 w-[70px] shrink-0 fill-[#E9A100]"><path transform="translate(0 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(20 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(40 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(60 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(80 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path></svg><blockquote class="mt-2.5 text-[15px] leading-relaxed text-ink">“Şu an ortaokulda olan büyük kızımla 2012’de başlayan Şeker Akademi maceram, 2021’de küçük kızımla devam etti. Bu yıl o da mezun oluyor. Hiç pişman olmadım.”</blockquote><figcaption class="mt-3 text-[13px] leading-snug text-ink-soft"><span class="font-bold text-ink">Arzu Ö.</span><span class="block">Google yorumu · iki çocuğunu da gönderen veli</span></figcaption></figure></li></ul></div></div><div id="form" class="mt-8 scroll-mt-3 border-t border-rule bg-paper-warm px-5 pt-8 pb-10 sm:px-6 lg:sticky lg:top-6 lg:mt-0 lg:rounded-[28px] lg:border lg:bg-white lg:p-8 lg:shadow-[0_18px_50px_-24px_rgb(46_16_101/0.35)]"><h2 class="text-[1.625rem] text-ink lg:text-[1.5rem]">Size özel hesabı konuşalım</h2><p class="mt-1.5 text-[15px] text-ink-soft">Size uygun bir saat seçin. Kayıt zorunluluğu yok.</p><div class="mt-6"><form novalidate="" class="space-y-5"><input readonly="" type="hidden" value="" name="gclid"><input readonly="" type="hidden" value="" name="fbclid"><input readonly="" type="hidden" value="" name="fbc"><input readonly="" type="hidden" value="" name="fbp"><input readonly="" type="hidden" value="/" name="landingPath"><input readonly="" type="hidden" value="" name="utm_source"><input readonly="" type="hidden" value="" name="utm_medium"><input readonly="" type="hidden" value="" name="utm_campaign"><input readonly="" type="hidden" value="" name="utm_term"><input readonly="" type="hidden" value="" name="utm_content"><div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden"><label for="website">Web siteniz</label><input id="website" tabindex="-1" autocomplete="off" type="text" name="website"></div><div class="grid gap-5 md:grid-cols-2"><div><label for="parentName" class="mb-1.5 block text-sm font-semibold text-ink">Adınız</label><input id="parentName" autocomplete="name" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark" required="" name="parentName"></div><div><label for="phone" class="mb-1.5 block text-sm font-semibold text-ink">Telefon numaranız</label><input id="phone" inputmode="tel" autocomplete="tel" placeholder="05XX XXX XX XX" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark" required="" type="tel" name="phone"></div></div><fieldset><legend class="mb-1.5 block text-sm font-semibold text-ink">Çocuğunuzun doğum ayı ve yılı</legend><div class="grid grid-cols-2 gap-3"><div><label for="childBirthMonth" class="sr-only">Doğum ayı</label><select id="childBirthMonth" name="childBirthMonth" required="" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark min-h-[44px]"><option value="">Ay</option><option value="1">Ocak</option><option value="2">Şubat</option><option value="3">Mart</option><option value="4">Nisan</option><option value="5">Mayıs</option><option value="6">Haziran</option><option value="7">Temmuz</option><option value="8">Ağustos</option><option value="9">Eylül</option><option value="10">Ekim</option><option value="11">Kasım</option><option value="12">Aralık</option></select></div><div><label for="childBirthYear" class="sr-only">Doğum yılı</label><select id="childBirthYear" name="childBirthYear" required="" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark min-h-[44px]"><option value="">Yıl</option><option value="2026">2026</option><option value="2025">2025</option><option value="2024">2024</option><option value="2023">2023</option><option value="2022">2022</option><option value="2021">2021</option><option value="2020">2020</option><option value="2019">2019</option></select></div></div></fieldset><div><label for="district" class="mb-1.5 block text-sm font-semibold text-ink">Oturduğunuz semt</label><select id="district" name="district" required="" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark min-h-[44px]"><option value="">Seçin</option><option value="Beykent">Beykent</option><option value="Beylikdüzü">Beylikdüzü</option><option value="Büyükçekmece">Büyükçekmece</option><option value="Esenyurt">Esenyurt</option><option value="Gürpınar">Gürpınar</option><option value="Yakuplu">Yakuplu</option><option value="Diğer">Diğer</option></select></div><fieldset><legend class="mb-1.5 block text-sm font-semibold text-ink">Ne zaman başlamayı düşünüyorsunuz?</legend><div class="grid gap-2 sm:grid-cols-2"><label class="flex min-h-[44px] items-center gap-3 rounded-xl border-2 border-rule bg-white px-4 py-2 text-ink"><input required="" class="h-5 w-5" type="radio" value="hemen" name="startWindow"><span>Hemen</span></label><label class="flex min-h-[44px] items-center gap-3 rounded-xl border-2 border-rule bg-white px-4 py-2 text-ink"><input required="" class="h-5 w-5" type="radio" value="1_3_ay" name="startWindow"><span>1–3 ay içinde</span></label><label class="flex min-h-[44px] items-center gap-3 rounded-xl border-2 border-rule bg-white px-4 py-2 text-ink"><input required="" class="h-5 w-5" type="radio" value="3_6_ay" name="startWindow"><span>3–6 ay içinde</span></label><label class="flex min-h-[44px] items-center gap-3 rounded-xl border-2 border-rule bg-white px-4 py-2 text-ink"><input required="" class="h-5 w-5" type="radio" value="gelecek_yil" name="startWindow"><span>Gelecek eğitim yılı</span></label></div></fieldset><label class="flex min-h-[44px] items-center gap-3 text-ink"><input class="h-5 w-5" type="checkbox" name="wantsWhatsapp"><span>WhatsApp'tan yazmamızı ister misiniz?</span></label><label class="flex items-start gap-3 text-sm text-ink-soft"><input required="" class="mt-1 h-4 w-4" type="checkbox" name="kvkkConsent"><span><a href="/gizlilik" class="underline">KVKK Aydınlatma Metni</a>'ni okudum. Başvurum için aranmama ve başvuru bilgilerimin reklamlarımızın etkinliğini ölçmek amacıyla Google ile paylaşılmasına onay veriyorum.</span></label><button type="submit" class="w-full rounded-full bg-grape px-8 py-4 text-lg font-semibold text-white shadow-lg shadow-grape/30 transition hover:bg-ink disabled:opacity-60">Beni Arayın</button><p class="text-center text-sm text-ink-soft">Numaranızı bırakın, <strong>15 dakika</strong> içinde sizi arayalım.</p></form></div></div></div></section><div class="mx-auto max-w-5xl px-5 pt-12 sm:px-6"><div class="relative w-full overflow-hidden rounded-3xl bg-paper-warm ring-1 ring-rule aspect-[3/2]"><img alt="Bahçedeki ahşap oyun mutfağı: tencereler, kepçeler ve &quot;Küçük Şeflerin Mutfağı&quot; yazılı kara tahta" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; color: transparent;" sizes="(max-width: 768px) 100vw, 1100px" srcset="/_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=3840&amp;q=75"></div></div><section class="mx-auto max-w-3xl px-6 py-14"><div class="mb-10 last:mb-0"><h2 class="text-2xl text-ink">Bir — sınıf modeli</h2><p class="mt-3 text-ink-soft">Öğretmen başına düşen çocuk sayısını düşük tutmak yapısal olarak daha maliyetlidir. Sınıflarımızda 13 çocuk ve 2 öğretmen bulunur — öğretmen başına 7 çocuk düşer. Ücretimizin en büyük bileşeni budur.</p></div><div class="mb-10 last:mb-0"><h2 class="text-2xl text-ink">İki — program genişliği</h2><p class="mt-3 text-ink-soft">Tam gün, yarım gün ve yaz dönemi farklı fiyatlanır. Seramik, müzik, drama, bale, satranç ve robotik kodlama gibi branş dersleri ile okulumuzda görev yapan uzman psikoloğun desteği programa dahildir. İngilizce bizde ayrı bir ders saati değil; oyunun, sofranın ve geçişlerin içinde kullanılan ikinci dil. Çocuğunuz her gün 2 saatini İngilizce öğretmeniyle geçirir.</p></div><div class="mb-10 last:mb-0"><h2 class="text-2xl text-ink">Üç — servis ve ödeme planı</h2><p class="mt-3 text-ink-soft">Servis ihtiyacınız varsa adresinize göre ayrıca hesaplanır. Ödeme planı, ailenizin ihtiyacına göre ön görüşmede birlikte belirlenir.</p></div></section><section class="mx-auto max-w-4xl px-6 pb-14"><div class="grid gap-4 md:grid-cols-2"><figure class="h-full rounded-2xl border border-rule bg-white px-4 py-4 lg:px-5"><svg aria-hidden="true" viewBox="0 0 100 20" class="block h-3.5 w-[70px] shrink-0 fill-[#E9A100]"><path transform="translate(0 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(20 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(40 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(60 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(80 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path></svg><blockquote class="mt-2.5 text-[15px] leading-relaxed text-ink">“Okul öncesi eğitimin kapsamlı olduğu, velinin neredeyse her an hem telefonla hem uygulamadan bilgilendirildiği, öğretmenlerin güler yüzlü olduğu beş yıldızlık bir okul.”</blockquote><figcaption class="mt-3 text-[13px] leading-snug text-ink-soft"><span class="font-bold text-ink">Ece P.</span><span class="block">Google yorumu</span></figcaption></figure><figure class="h-full rounded-2xl border border-rule bg-white px-4 py-4 lg:px-5"><svg aria-hidden="true" viewBox="0 0 100 20" class="block h-3.5 w-[70px] shrink-0 fill-[#E9A100]"><path transform="translate(0 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(20 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(40 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(60 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(80 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path></svg><blockquote class="mt-2.5 text-[15px] leading-relaxed text-ink">“3 yılın sonunda akademik olarak branş derslerinde iyi olan, daha önemlisi kendini rahat ifade edebilen, hakkını arayan, hayvan seven, yemek seçmeyen, sosyal kurallara uyan bir çocuğum var.”</blockquote><figcaption class="mt-3 text-[13px] leading-snug text-ink-soft"><span class="font-bold text-ink">Yonca M.</span><span class="block">Google yorumu · 3 yıl sonunda</span></figcaption></figure></div></section><section class="mx-auto max-w-3xl px-6 pb-14"><h2 class="text-3xl text-ink">Sıkça Sorulanlar</h2><dl class="mt-8 space-y-6"><div class="border-t border-rule pt-6"><dt class="font-medium text-ink">Neden rakamı sitede yazmıyorsunuz?</dt><dd class="mt-2 text-ink-soft">Ücret programa, gün sayısına ve servis ihtiyacına göre değiştiği için tek bir rakam yanıltıcı olur. Ön görüşmede size özel bir hesap paylaşıyoruz.</dd></div><div class="border-t border-rule pt-6"><dt class="font-medium text-ink">Ücrete neler dahil?</dt><dd class="mt-2 text-ink-soft">Branş dersleri, günlük İngilizce ve rehberlik desteği programa dahildir; servis ayrıca hesaplanır. Hangi kalemin dahil olduğunu ön görüşmede kalem kalem yazılı paylaşıyoruz.</dd></div><div class="border-t border-rule pt-6"><dt class="font-medium text-ink">Ödeme planı seçebiliyor muyum?</dt><dd class="mt-2 text-ink-soft">Ödeme planı, ailenizin ihtiyacına göre ön görüşmede sizinle birlikte belirlenir.</dd></div><div class="border-t border-rule pt-6"><dt class="font-medium text-ink">Ücret ne zaman netleşiyor?</dt><dd class="mt-2 text-ink-soft">Ön görüşmede çocuğunuzun yaş grubuna göre net ücreti yazılı paylaşıyoruz.</dd></div></dl></section><section class="border-t border-rule bg-paper-warm py-14"><div class="mx-auto max-w-3xl px-6 text-center"><h2 class="text-3xl text-ink">Okulu gezin, sonra karar verin</h2><p class="mt-4 text-ink-soft">Cumhuriyet Mahallesi, Uludağ Sokak No:6, Beykent, Büyükçekmece/İstanbul</p><div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row"><a href="#form" class="rounded-full bg-ink px-8 py-4 text-paper">Ön Görüşme Randevusu</a><a href="tel:+905301018875" class="rounded-full border border-ink px-8 py-4 text-ink">0530 101 88 75</a><a href="https://maps.google.com/?q=Cumhuriyet%20Mahallesi%2C%20Uluda%C4%9F%20Sokak%20No%3A6%20Beykent%2C%20B%C3%BCy%C3%BCk%C3%A7ekmece%2F%C4%B0stanbul" target="_blank" rel="noopener noreferrer" class="rounded-full border border-ink px-8 py-4 text-ink">Haritada Gör</a></div></div></section></div>"`;

exports[`reklam sayfaları ziyaretçi HTML > az-mevcutlu-anaokulu: düzenleme katmanından önceki hâliyle aynı 1`] = `"<div class="bg-paper"><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Sınıfınızda kaç çocuk var?","acceptedAnswer":{"@type":"Answer","text":"Sınıflarımızda 13 çocuk ve 2 öğretmen bulunur — öğretmen başına 7 çocuk düşer."}},{"@type":"Question","name":"MEB yönetmeliği kaç çocuğa izin veriyor?","acceptedAnswer":{"@type":"Answer","text":"Okul öncesi yönetmeliği öğretmen başına 20 çocuğa kadar izin veriyor. Bizde öğretmen başına 7 çocuk düşüyor."}},{"@type":"Question","name":"Hangi yaş gruplarını kabul ediyorsunuz?","acceptedAnswer":{"@type":"Answer","text":"İki yaşından beş yaşının sonuna kadar dört grubumuz var: 2-3, 3-4, 4-5 ve 5-6 yaş."}},{"@type":"Question","name":"Okulu gezebilir miyim?","acceptedAnswer":{"@type":"Answer","text":"Evet. Ön görüşme randevunuzda ders saatinde gelip sınıfı görebilirsiniz; kayıt zorunluluğu yoktur."}}]}</script><section><div class="mx-auto max-w-6xl lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,420px)] lg:items-start lg:gap-12 lg:px-6 lg:pt-10 lg:pb-16"><div class="flex min-w-0 flex-col"><div class="relative aspect-[3/2] overflow-hidden bg-paper-warm min-[375px]:aspect-[4/3] lg:order-2 lg:mt-7 lg:aspect-[3/2] lg:rounded-[28px]"><img alt="Şeker Anaokulu bahçesi: çim alan, ağaçlar, ahşap oyun evi ve piknik masası" fetchpriority="high" loading="eager" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; color: transparent;" sizes="(min-width: 1152px) 690px, (min-width: 1024px) 60vw, 100vw" srcset="/_next/image?url=%2Fbahce-genis.webp&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fbahce-genis.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fbahce-genis.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fbahce-genis.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fbahce-genis.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fbahce-genis.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fbahce-genis.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fbahce-genis.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fbahce-genis.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fbahce-genis.webp&amp;w=3840&amp;q=75"><div aria-hidden="true" class="scallop absolute inset-x-0 -bottom-px lg:hidden"></div></div><div class="px-5 pt-4 sm:px-6 lg:order-1 lg:px-0 lg:pt-0"><h1 class="lp-title text-balance text-ink">Bir çocuğun okulda en çok neye ihtiyacı vardır? Kaliteli ve Birebir İlgiye!</h1><p class="lp-lede mt-2.5 max-w-[60ch] whitespace-pre-line text-ink-soft lg:mt-4">Sınıfta 13 çocuk ve 2 öğretmen var; öğretmen başına 7 çocuk düşer. Ön görüşmede ders saatinde gelip sınıfı kendiniz görebilirsiniz.</p><a href="#form" class="mt-4 flex min-h-12 items-center justify-center rounded-full bg-grape px-6 text-base font-semibold text-white shadow-md shadow-grape/25 lg:hidden">Ön Görüşme Randevusu</a></div><div class="px-5 sm:px-6 lg:order-3 lg:px-0"><dl class="mt-6 grid grid-cols-3 border-y border-rule py-4 sm:grid-cols-4 lg:mt-7"><div class="min-w-0 border-l border-rule px-3 first:border-l-0 first:pl-0 "><dt class="font-display text-[1.375rem] leading-none font-semibold text-ink lg:text-[1.625rem]">15 yıl</dt><dd class="mt-1.5 text-[13px] leading-snug text-ink-soft">Beykent'te aynı adreste</dd></div><div class="min-w-0 border-l border-rule px-3 first:border-l-0 first:pl-0 "><dt class="font-display text-[1.375rem] leading-none font-semibold text-ink lg:text-[1.625rem]">13</dt><dd class="mt-1.5 text-[13px] leading-snug text-ink-soft">Sınıf mevcudu</dd></div><div class="min-w-0 border-l border-rule px-3 first:border-l-0 first:pl-0 "><dt class="font-display text-[1.375rem] leading-none font-semibold text-ink lg:text-[1.625rem]">1 : 7</dt><dd class="mt-1.5 text-[13px] leading-snug text-ink-soft">Öğretmen başına çocuk</dd></div><div class="min-w-0 border-l border-rule px-3 first:border-l-0 first:pl-0 hidden sm:block"><dt class="font-display text-[1.375rem] leading-none font-semibold text-ink lg:text-[1.625rem]">2-6</dt><dd class="mt-1.5 text-[13px] leading-snug text-ink-soft">Yaş aralığı</dd></div></dl><ul class="mt-6 grid gap-3 lg:mt-7 lg:grid-cols-2 lg:gap-4"><li class="min-w-0"><figure class="h-full rounded-2xl border border-rule bg-white px-4 py-4 lg:px-5"><svg aria-hidden="true" viewBox="0 0 100 20" class="block h-3.5 w-[70px] shrink-0 fill-[#E9A100]"><path transform="translate(0 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(20 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(40 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(60 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(80 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path></svg><blockquote class="mt-2.5 text-[15px] leading-relaxed text-ink">“Şu an 4 yaşında olan kızımız için 1,5 yıl içinde 3 farklı yer denedik. Daha köklü ve iyi olur diye kolej anaokuluna bile gönderdik. Sonunda burada karar kıldık.”</blockquote><figcaption class="mt-3 text-[13px] leading-snug text-ink-soft"><span class="font-bold text-ink">Emre</span><span class="block">Google yorumu · 4 yaş velisi</span></figcaption></figure></li><li class="min-w-0"><figure class="h-full rounded-2xl border border-rule bg-white px-4 py-4 lg:px-5"><svg aria-hidden="true" viewBox="0 0 100 20" class="block h-3.5 w-[70px] shrink-0 fill-[#E9A100]"><path transform="translate(0 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(20 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(40 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(60 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(80 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path></svg><blockquote class="mt-2.5 text-[15px] leading-relaxed text-ink">“Şu an ortaokulda olan büyük kızımla 2012’de başlayan Şeker Akademi maceram, 2021’de küçük kızımla devam etti. Bu yıl o da mezun oluyor. Hiç pişman olmadım.”</blockquote><figcaption class="mt-3 text-[13px] leading-snug text-ink-soft"><span class="font-bold text-ink">Arzu Ö.</span><span class="block">Google yorumu · iki çocuğunu da gönderen veli</span></figcaption></figure></li></ul></div></div><div id="form" class="mt-8 scroll-mt-3 border-t border-rule bg-paper-warm px-5 pt-8 pb-10 sm:px-6 lg:sticky lg:top-6 lg:mt-0 lg:rounded-[28px] lg:border lg:bg-white lg:p-8 lg:shadow-[0_18px_50px_-24px_rgb(46_16_101/0.35)]"><h2 class="text-[1.625rem] text-ink lg:text-[1.5rem]">Sınıfı kendiniz görün</h2><p class="mt-1.5 text-[15px] text-ink-soft">Size uygun bir saat seçin. Kayıt zorunluluğu yok.</p><div class="mt-6"><form novalidate="" class="space-y-5"><input readonly="" type="hidden" value="" name="gclid"><input readonly="" type="hidden" value="" name="fbclid"><input readonly="" type="hidden" value="" name="fbc"><input readonly="" type="hidden" value="" name="fbp"><input readonly="" type="hidden" value="/" name="landingPath"><input readonly="" type="hidden" value="" name="utm_source"><input readonly="" type="hidden" value="" name="utm_medium"><input readonly="" type="hidden" value="" name="utm_campaign"><input readonly="" type="hidden" value="" name="utm_term"><input readonly="" type="hidden" value="" name="utm_content"><div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden"><label for="website">Web siteniz</label><input id="website" tabindex="-1" autocomplete="off" type="text" name="website"></div><div class="grid gap-5 md:grid-cols-2"><div><label for="parentName" class="mb-1.5 block text-sm font-semibold text-ink">Adınız</label><input id="parentName" autocomplete="name" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark" required="" name="parentName"></div><div><label for="phone" class="mb-1.5 block text-sm font-semibold text-ink">Telefon numaranız</label><input id="phone" inputmode="tel" autocomplete="tel" placeholder="05XX XXX XX XX" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark" required="" type="tel" name="phone"></div></div><fieldset><legend class="mb-1.5 block text-sm font-semibold text-ink">Çocuğunuzun doğum ayı ve yılı</legend><div class="grid grid-cols-2 gap-3"><div><label for="childBirthMonth" class="sr-only">Doğum ayı</label><select id="childBirthMonth" name="childBirthMonth" required="" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark min-h-[44px]"><option value="">Ay</option><option value="1">Ocak</option><option value="2">Şubat</option><option value="3">Mart</option><option value="4">Nisan</option><option value="5">Mayıs</option><option value="6">Haziran</option><option value="7">Temmuz</option><option value="8">Ağustos</option><option value="9">Eylül</option><option value="10">Ekim</option><option value="11">Kasım</option><option value="12">Aralık</option></select></div><div><label for="childBirthYear" class="sr-only">Doğum yılı</label><select id="childBirthYear" name="childBirthYear" required="" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark min-h-[44px]"><option value="">Yıl</option><option value="2026">2026</option><option value="2025">2025</option><option value="2024">2024</option><option value="2023">2023</option><option value="2022">2022</option><option value="2021">2021</option><option value="2020">2020</option><option value="2019">2019</option></select></div></div></fieldset><div><label for="district" class="mb-1.5 block text-sm font-semibold text-ink">Oturduğunuz semt</label><select id="district" name="district" required="" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark min-h-[44px]"><option value="">Seçin</option><option value="Beykent">Beykent</option><option value="Beylikdüzü">Beylikdüzü</option><option value="Büyükçekmece">Büyükçekmece</option><option value="Esenyurt">Esenyurt</option><option value="Gürpınar">Gürpınar</option><option value="Yakuplu">Yakuplu</option><option value="Diğer">Diğer</option></select></div><fieldset><legend class="mb-1.5 block text-sm font-semibold text-ink">Ne zaman başlamayı düşünüyorsunuz?</legend><div class="grid gap-2 sm:grid-cols-2"><label class="flex min-h-[44px] items-center gap-3 rounded-xl border-2 border-rule bg-white px-4 py-2 text-ink"><input required="" class="h-5 w-5" type="radio" value="hemen" name="startWindow"><span>Hemen</span></label><label class="flex min-h-[44px] items-center gap-3 rounded-xl border-2 border-rule bg-white px-4 py-2 text-ink"><input required="" class="h-5 w-5" type="radio" value="1_3_ay" name="startWindow"><span>1–3 ay içinde</span></label><label class="flex min-h-[44px] items-center gap-3 rounded-xl border-2 border-rule bg-white px-4 py-2 text-ink"><input required="" class="h-5 w-5" type="radio" value="3_6_ay" name="startWindow"><span>3–6 ay içinde</span></label><label class="flex min-h-[44px] items-center gap-3 rounded-xl border-2 border-rule bg-white px-4 py-2 text-ink"><input required="" class="h-5 w-5" type="radio" value="gelecek_yil" name="startWindow"><span>Gelecek eğitim yılı</span></label></div></fieldset><label class="flex min-h-[44px] items-center gap-3 text-ink"><input class="h-5 w-5" type="checkbox" name="wantsWhatsapp"><span>WhatsApp'tan yazmamızı ister misiniz?</span></label><label class="flex items-start gap-3 text-sm text-ink-soft"><input required="" class="mt-1 h-4 w-4" type="checkbox" name="kvkkConsent"><span><a href="/gizlilik" class="underline">KVKK Aydınlatma Metni</a>'ni okudum. Başvurum için aranmama ve başvuru bilgilerimin reklamlarımızın etkinliğini ölçmek amacıyla Google ile paylaşılmasına onay veriyorum.</span></label><button type="submit" class="w-full rounded-full bg-grape px-8 py-4 text-lg font-semibold text-white shadow-lg shadow-grape/30 transition hover:bg-ink disabled:opacity-60">Beni Arayın</button><p class="text-center text-sm text-ink-soft">Numaranızı bırakın, <strong>15 dakika</strong> içinde sizi arayalım.</p></form></div></div></div></section><div class="mx-auto max-w-5xl px-5 pt-12 sm:px-6"><div class="relative w-full overflow-hidden rounded-3xl bg-paper-warm ring-1 ring-rule aspect-[3/2]"><img alt="Bahçedeki ahşap oyun mutfağı: tencereler, kepçeler ve &quot;Küçük Şeflerin Mutfağı&quot; yazılı kara tahta" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; color: transparent;" sizes="(max-width: 768px) 100vw, 1100px" srcset="/_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=3840&amp;q=75"></div></div><section class="mx-auto max-w-3xl px-6 py-14"><div class="mb-10 last:mb-0"><h2 class="text-2xl text-ink">Rakamın pratikte anlamı</h2><p class="mt-3 text-ink-soft">Sınıflarımızda 13 çocuk ve 2 öğretmen bulunur — öğretmen başına 7 çocuk düşer. İkinci öğretmenin olması şu demek: bir çocuk ağladığında ya da tuvalete götürülmesi gerektiğinde sınıfın geri kalanı boşta kalmıyor.</p></div><div class="mb-10 last:mb-0"><h2 class="text-2xl text-ink">Çekingen çocuk için belirleyici</h2><p class="mt-3 text-ink-soft">Kalabalık bir sınıfta konuşmayan çocuk sorun çıkarmadığı için en son fark edilendir. Bu mevcutta öğretmen, gün içinde kimin söz almadığını görebiliyor.</p></div><div class="mb-10 last:mb-0"><h2 class="text-2xl text-ink">Gelip kendiniz sayın</h2><p class="mt-3 text-ink-soft">En ikna edici kanıt bir web sitesi rakamı değil, gözünüzle gördüğünüzdür. Ön görüşme randevunuzda ders saatinde gelin, sınıfa girin, çocukları ve öğretmenleri sayın.</p></div></section><section class="mx-auto max-w-4xl px-6 pb-14"><div class="grid gap-4 md:grid-cols-2"><figure class="h-full rounded-2xl border border-rule bg-white px-4 py-4 lg:px-5"><svg aria-hidden="true" viewBox="0 0 100 20" class="block h-3.5 w-[70px] shrink-0 fill-[#E9A100]"><path transform="translate(0 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(20 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(40 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(60 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(80 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path></svg><blockquote class="mt-2.5 text-[15px] leading-relaxed text-ink">“Okul öncesi eğitimin kapsamlı olduğu, velinin neredeyse her an hem telefonla hem uygulamadan bilgilendirildiği, öğretmenlerin güler yüzlü olduğu beş yıldızlık bir okul.”</blockquote><figcaption class="mt-3 text-[13px] leading-snug text-ink-soft"><span class="font-bold text-ink">Ece P.</span><span class="block">Google yorumu</span></figcaption></figure><figure class="h-full rounded-2xl border border-rule bg-white px-4 py-4 lg:px-5"><svg aria-hidden="true" viewBox="0 0 100 20" class="block h-3.5 w-[70px] shrink-0 fill-[#E9A100]"><path transform="translate(0 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(20 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(40 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(60 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(80 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path></svg><blockquote class="mt-2.5 text-[15px] leading-relaxed text-ink">“3 yılın sonunda akademik olarak branş derslerinde iyi olan, daha önemlisi kendini rahat ifade edebilen, hakkını arayan, hayvan seven, yemek seçmeyen, sosyal kurallara uyan bir çocuğum var.”</blockquote><figcaption class="mt-3 text-[13px] leading-snug text-ink-soft"><span class="font-bold text-ink">Yonca M.</span><span class="block">Google yorumu · 3 yıl sonunda</span></figcaption></figure></div></section><section class="mx-auto max-w-3xl px-6 pb-14"><h2 class="text-3xl text-ink">Sıkça Sorulanlar</h2><dl class="mt-8 space-y-6"><div class="border-t border-rule pt-6"><dt class="font-medium text-ink">Sınıfınızda kaç çocuk var?</dt><dd class="mt-2 text-ink-soft">Sınıflarımızda 13 çocuk ve 2 öğretmen bulunur — öğretmen başına 7 çocuk düşer.</dd></div><div class="border-t border-rule pt-6"><dt class="font-medium text-ink">MEB yönetmeliği kaç çocuğa izin veriyor?</dt><dd class="mt-2 text-ink-soft">Okul öncesi yönetmeliği öğretmen başına 20 çocuğa kadar izin veriyor. Bizde öğretmen başına 7 çocuk düşüyor.</dd></div><div class="border-t border-rule pt-6"><dt class="font-medium text-ink">Hangi yaş gruplarını kabul ediyorsunuz?</dt><dd class="mt-2 text-ink-soft">İki yaşından beş yaşının sonuna kadar dört grubumuz var: 2-3, 3-4, 4-5 ve 5-6 yaş.</dd></div><div class="border-t border-rule pt-6"><dt class="font-medium text-ink">Okulu gezebilir miyim?</dt><dd class="mt-2 text-ink-soft">Evet. Ön görüşme randevunuzda ders saatinde gelip sınıfı görebilirsiniz; kayıt zorunluluğu yoktur.</dd></div></dl></section><section class="border-t border-rule bg-paper-warm py-14"><div class="mx-auto max-w-3xl px-6 text-center"><h2 class="text-3xl text-ink">Okulu gezin, sonra karar verin</h2><p class="mt-4 text-ink-soft">Cumhuriyet Mahallesi, Uludağ Sokak No:6, Beykent, Büyükçekmece/İstanbul</p><div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row"><a href="#form" class="rounded-full bg-ink px-8 py-4 text-paper">Ön Görüşme Randevusu</a><a href="tel:+905301018875" class="rounded-full border border-ink px-8 py-4 text-ink">0530 101 88 75</a><a href="https://maps.google.com/?q=Cumhuriyet%20Mahallesi%2C%20Uluda%C4%9F%20Sokak%20No%3A6%20Beykent%2C%20B%C3%BCy%C3%BCk%C3%A7ekmece%2F%C4%B0stanbul" target="_blank" rel="noopener noreferrer" class="rounded-full border border-ink px-8 py-4 text-ink">Haritada Gör</a></div></div></section></div>"`;

exports[`reklam sayfaları ziyaretçi HTML > beykent-anaokulu: düzenleme katmanından önceki hâliyle aynı 1`] = `"<div class="bg-paper"><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Hangi yaş gruplarını kabul ediyorsunuz?","acceptedAnswer":{"@type":"Answer","text":"İki yaşından beş yaşının sonuna kadar dört grubumuz var: 2-3, 3-4, 4-5 ve 5-6 yaş."}},{"@type":"Question","name":"Sınıf mevcudunuz kaç?","acceptedAnswer":{"@type":"Answer","text":"Sınıflarımızda 13 çocuk ve 2 öğretmen bulunur — öğretmen başına 7 çocuk düşer."}},{"@type":"Question","name":"Ücret bilgisini nasıl alabilirim?","acceptedAnswer":{"@type":"Answer","text":"Ücreti ön görüşmede yazılı olarak paylaşıyoruz; programa, gün sayısına ve servis ihtiyacına göre değiştiği için sitede tek bir rakam yayımlamıyoruz."}},{"@type":"Question","name":"Okulu gezebilir miyim?","acceptedAnswer":{"@type":"Answer","text":"Evet. Ön görüşme randevunuzda ders saatinde gelip sınıfı görebilirsiniz; kayıt zorunluluğu yoktur."}}]}</script><section><div class="mx-auto max-w-6xl lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,420px)] lg:items-start lg:gap-12 lg:px-6 lg:pt-10 lg:pb-16"><div class="flex min-w-0 flex-col"><div class="relative aspect-[3/2] overflow-hidden bg-paper-warm min-[375px]:aspect-[4/3] lg:order-2 lg:mt-7 lg:aspect-[3/2] lg:rounded-[28px]"><img alt="Şeker Anaokulu bahçesi: çim alan, ağaçlar, ahşap oyun evi ve piknik masası" fetchpriority="high" loading="eager" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; color: transparent;" sizes="(min-width: 1152px) 690px, (min-width: 1024px) 60vw, 100vw" srcset="/_next/image?url=%2Fbahce-genis.webp&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fbahce-genis.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fbahce-genis.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fbahce-genis.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fbahce-genis.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fbahce-genis.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fbahce-genis.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fbahce-genis.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fbahce-genis.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fbahce-genis.webp&amp;w=3840&amp;q=75"><div aria-hidden="true" class="scallop absolute inset-x-0 -bottom-px lg:hidden"></div></div><div class="px-5 pt-4 sm:px-6 lg:order-1 lg:px-0 lg:pt-0"><h1 class="lp-title text-balance text-ink">Çocuğunuz İçin Beykent’in Merkezinde, Güvenle Büyüyeceği Bir Gelecek</h1><p class="lp-lede mt-2.5 max-w-[60ch] whitespace-pre-line text-ink-soft lg:mt-4">Cumhuriyet Mahallesi’nde 2011’den beri aynı adresteyiz. Sınıflarımızda 13 çocuk ve 2 öğretmen var. Servis güzergâhınızı ön görüşmede birlikte planlıyoruz.</p><a href="#form" class="mt-4 flex min-h-12 items-center justify-center rounded-full bg-grape px-6 text-base font-semibold text-white shadow-md shadow-grape/25 lg:hidden">Ön Görüşme Randevusu</a></div><div class="px-5 sm:px-6 lg:order-3 lg:px-0"><dl class="mt-6 grid grid-cols-3 border-y border-rule py-4 sm:grid-cols-4 lg:mt-7"><div class="min-w-0 border-l border-rule px-3 first:border-l-0 first:pl-0 "><dt class="font-display text-[1.375rem] leading-none font-semibold text-ink lg:text-[1.625rem]">15 yıl</dt><dd class="mt-1.5 text-[13px] leading-snug text-ink-soft">Beykent'te aynı adreste</dd></div><div class="min-w-0 border-l border-rule px-3 first:border-l-0 first:pl-0 "><dt class="font-display text-[1.375rem] leading-none font-semibold text-ink lg:text-[1.625rem]">13</dt><dd class="mt-1.5 text-[13px] leading-snug text-ink-soft">Sınıf mevcudu</dd></div><div class="min-w-0 border-l border-rule px-3 first:border-l-0 first:pl-0 "><dt class="font-display text-[1.375rem] leading-none font-semibold text-ink lg:text-[1.625rem]">1 : 7</dt><dd class="mt-1.5 text-[13px] leading-snug text-ink-soft">Öğretmen başına çocuk</dd></div><div class="min-w-0 border-l border-rule px-3 first:border-l-0 first:pl-0 hidden sm:block"><dt class="font-display text-[1.375rem] leading-none font-semibold text-ink lg:text-[1.625rem]">2-6</dt><dd class="mt-1.5 text-[13px] leading-snug text-ink-soft">Yaş aralığı</dd></div></dl><ul class="mt-6 grid gap-3 lg:mt-7 lg:grid-cols-2 lg:gap-4"><li class="min-w-0"><figure class="h-full rounded-2xl border border-rule bg-white px-4 py-4 lg:px-5"><svg aria-hidden="true" viewBox="0 0 100 20" class="block h-3.5 w-[70px] shrink-0 fill-[#E9A100]"><path transform="translate(0 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(20 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(40 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(60 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(80 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path></svg><blockquote class="mt-2.5 text-[15px] leading-relaxed text-ink">“Şu an 4 yaşında olan kızımız için 1,5 yıl içinde 3 farklı yer denedik. Daha köklü ve iyi olur diye kolej anaokuluna bile gönderdik. Sonunda burada karar kıldık.”</blockquote><figcaption class="mt-3 text-[13px] leading-snug text-ink-soft"><span class="font-bold text-ink">Emre</span><span class="block">Google yorumu · 4 yaş velisi</span></figcaption></figure></li><li class="min-w-0"><figure class="h-full rounded-2xl border border-rule bg-white px-4 py-4 lg:px-5"><svg aria-hidden="true" viewBox="0 0 100 20" class="block h-3.5 w-[70px] shrink-0 fill-[#E9A100]"><path transform="translate(0 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(20 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(40 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(60 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(80 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path></svg><blockquote class="mt-2.5 text-[15px] leading-relaxed text-ink">“Şu an ortaokulda olan büyük kızımla 2012’de başlayan Şeker Akademi maceram, 2021’de küçük kızımla devam etti. Bu yıl o da mezun oluyor. Hiç pişman olmadım.”</blockquote><figcaption class="mt-3 text-[13px] leading-snug text-ink-soft"><span class="font-bold text-ink">Arzu Ö.</span><span class="block">Google yorumu · iki çocuğunu da gönderen veli</span></figcaption></figure></li></ul></div></div><div id="form" class="mt-8 scroll-mt-3 border-t border-rule bg-paper-warm px-5 pt-8 pb-10 sm:px-6 lg:sticky lg:top-6 lg:mt-0 lg:rounded-[28px] lg:border lg:bg-white lg:p-8 lg:shadow-[0_18px_50px_-24px_rgb(46_16_101/0.35)]"><h2 class="text-[1.625rem] text-ink lg:text-[1.5rem]">Okulu gezin, sonra karar verin</h2><p class="mt-1.5 text-[15px] text-ink-soft">Size uygun bir saat seçin. Kayıt zorunluluğu yok.</p><div class="mt-6"><form novalidate="" class="space-y-5"><input readonly="" type="hidden" value="" name="gclid"><input readonly="" type="hidden" value="" name="fbclid"><input readonly="" type="hidden" value="" name="fbc"><input readonly="" type="hidden" value="" name="fbp"><input readonly="" type="hidden" value="/" name="landingPath"><input readonly="" type="hidden" value="" name="utm_source"><input readonly="" type="hidden" value="" name="utm_medium"><input readonly="" type="hidden" value="" name="utm_campaign"><input readonly="" type="hidden" value="" name="utm_term"><input readonly="" type="hidden" value="" name="utm_content"><div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden"><label for="website">Web siteniz</label><input id="website" tabindex="-1" autocomplete="off" type="text" name="website"></div><div class="grid gap-5 md:grid-cols-2"><div><label for="parentName" class="mb-1.5 block text-sm font-semibold text-ink">Adınız</label><input id="parentName" autocomplete="name" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark" required="" name="parentName"></div><div><label for="phone" class="mb-1.5 block text-sm font-semibold text-ink">Telefon numaranız</label><input id="phone" inputmode="tel" autocomplete="tel" placeholder="05XX XXX XX XX" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark" required="" type="tel" name="phone"></div></div><fieldset><legend class="mb-1.5 block text-sm font-semibold text-ink">Çocuğunuzun doğum ayı ve yılı</legend><div class="grid grid-cols-2 gap-3"><div><label for="childBirthMonth" class="sr-only">Doğum ayı</label><select id="childBirthMonth" name="childBirthMonth" required="" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark min-h-[44px]"><option value="">Ay</option><option value="1">Ocak</option><option value="2">Şubat</option><option value="3">Mart</option><option value="4">Nisan</option><option value="5">Mayıs</option><option value="6">Haziran</option><option value="7">Temmuz</option><option value="8">Ağustos</option><option value="9">Eylül</option><option value="10">Ekim</option><option value="11">Kasım</option><option value="12">Aralık</option></select></div><div><label for="childBirthYear" class="sr-only">Doğum yılı</label><select id="childBirthYear" name="childBirthYear" required="" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark min-h-[44px]"><option value="">Yıl</option><option value="2026">2026</option><option value="2025">2025</option><option value="2024">2024</option><option value="2023">2023</option><option value="2022">2022</option><option value="2021">2021</option><option value="2020">2020</option><option value="2019">2019</option></select></div></div></fieldset><div><label for="district" class="mb-1.5 block text-sm font-semibold text-ink">Oturduğunuz semt</label><select id="district" name="district" required="" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark min-h-[44px]"><option value="">Seçin</option><option value="Beykent">Beykent</option><option value="Beylikdüzü">Beylikdüzü</option><option value="Büyükçekmece">Büyükçekmece</option><option value="Esenyurt">Esenyurt</option><option value="Gürpınar">Gürpınar</option><option value="Yakuplu">Yakuplu</option><option value="Diğer">Diğer</option></select></div><fieldset><legend class="mb-1.5 block text-sm font-semibold text-ink">Ne zaman başlamayı düşünüyorsunuz?</legend><div class="grid gap-2 sm:grid-cols-2"><label class="flex min-h-[44px] items-center gap-3 rounded-xl border-2 border-rule bg-white px-4 py-2 text-ink"><input required="" class="h-5 w-5" type="radio" value="hemen" name="startWindow"><span>Hemen</span></label><label class="flex min-h-[44px] items-center gap-3 rounded-xl border-2 border-rule bg-white px-4 py-2 text-ink"><input required="" class="h-5 w-5" type="radio" value="1_3_ay" name="startWindow"><span>1–3 ay içinde</span></label><label class="flex min-h-[44px] items-center gap-3 rounded-xl border-2 border-rule bg-white px-4 py-2 text-ink"><input required="" class="h-5 w-5" type="radio" value="3_6_ay" name="startWindow"><span>3–6 ay içinde</span></label><label class="flex min-h-[44px] items-center gap-3 rounded-xl border-2 border-rule bg-white px-4 py-2 text-ink"><input required="" class="h-5 w-5" type="radio" value="gelecek_yil" name="startWindow"><span>Gelecek eğitim yılı</span></label></div></fieldset><label class="flex min-h-[44px] items-center gap-3 text-ink"><input class="h-5 w-5" type="checkbox" name="wantsWhatsapp"><span>WhatsApp'tan yazmamızı ister misiniz?</span></label><label class="flex items-start gap-3 text-sm text-ink-soft"><input required="" class="mt-1 h-4 w-4" type="checkbox" name="kvkkConsent"><span><a href="/gizlilik" class="underline">KVKK Aydınlatma Metni</a>'ni okudum. Başvurum için aranmama ve başvuru bilgilerimin reklamlarımızın etkinliğini ölçmek amacıyla Google ile paylaşılmasına onay veriyorum.</span></label><button type="submit" class="w-full rounded-full bg-grape px-8 py-4 text-lg font-semibold text-white shadow-lg shadow-grape/30 transition hover:bg-ink disabled:opacity-60">Beni Arayın</button><p class="text-center text-sm text-ink-soft">Numaranızı bırakın, <strong>15 dakika</strong> içinde sizi arayalım.</p></form></div></div></div></section><div class="mx-auto max-w-5xl px-5 pt-12 sm:px-6"><div class="relative w-full overflow-hidden rounded-3xl bg-paper-warm ring-1 ring-rule aspect-[3/2]"><img alt="Bahçedeki ahşap mutfak atölyesi, açık hava sınıfı ve ağacı çevreleyen oturma bankı" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; color: transparent;" sizes="(max-width: 768px) 100vw, 1100px" srcset="/_next/image?url=%2Fbahce-atolyeler.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fbahce-atolyeler.webp&amp;w=3840&amp;q=75"></div></div><section class="mx-auto max-w-3xl px-6 py-14"><div class="mb-10 last:mb-0"><h2 class="text-2xl text-ink">15 yıldır aynı sokakta</h2><p class="mt-3 text-ink-soft">Cumhuriyet Mahallesi Uludağ Sokak'ta 2011'den beri buradayız. Süreklilik, okul öncesinde en zor taklit edilen özelliktir.</p></div><div class="mb-10 last:mb-0"><h2 class="text-2xl text-ink">Neden sınıf mevcudunu bu kadar önemsiyoruz</h2><p class="mt-3 text-ink-soft">Bir öğretmenin gün içinde kaç kez çocuğunuza sıra ayırabileceğini belirleyen şey, o sınıfta kaç çocuk olduğudur. Sınıflarımızda 13 çocuk ve 2 öğretmen bulunur — öğretmen başına 7 çocuk düşer.</p></div><div class="mb-10 last:mb-0"><h2 class="text-2xl text-ink">Branş dersleri programın parçası</h2><p class="mt-3 text-ink-soft">İngilizce bizde ayrı bir ders saati değil; oyunun, sofranın ve geçişlerin içinde kullanılan ikinci dil. Çocuğunuz her gün 2 saatini İngilizce öğretmeniyle geçirir. Seramik, müzik, drama, bale, satranç ve robotik kodlama derslerinin her biri alanında uzman bir öğretmenle yürür; bir çocuk çamurla açılır, bir başkası satrançla.</p></div></section><section class="mx-auto max-w-4xl px-6 pb-14"><div class="grid gap-4 md:grid-cols-2"><figure class="h-full rounded-2xl border border-rule bg-white px-4 py-4 lg:px-5"><svg aria-hidden="true" viewBox="0 0 100 20" class="block h-3.5 w-[70px] shrink-0 fill-[#E9A100]"><path transform="translate(0 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(20 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(40 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(60 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(80 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path></svg><blockquote class="mt-2.5 text-[15px] leading-relaxed text-ink">“Okul öncesi eğitimin kapsamlı olduğu, velinin neredeyse her an hem telefonla hem uygulamadan bilgilendirildiği, öğretmenlerin güler yüzlü olduğu beş yıldızlık bir okul.”</blockquote><figcaption class="mt-3 text-[13px] leading-snug text-ink-soft"><span class="font-bold text-ink">Ece P.</span><span class="block">Google yorumu</span></figcaption></figure><figure class="h-full rounded-2xl border border-rule bg-white px-4 py-4 lg:px-5"><svg aria-hidden="true" viewBox="0 0 100 20" class="block h-3.5 w-[70px] shrink-0 fill-[#E9A100]"><path transform="translate(0 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(20 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(40 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(60 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(80 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path></svg><blockquote class="mt-2.5 text-[15px] leading-relaxed text-ink">“3 yılın sonunda akademik olarak branş derslerinde iyi olan, daha önemlisi kendini rahat ifade edebilen, hakkını arayan, hayvan seven, yemek seçmeyen, sosyal kurallara uyan bir çocuğum var.”</blockquote><figcaption class="mt-3 text-[13px] leading-snug text-ink-soft"><span class="font-bold text-ink">Yonca M.</span><span class="block">Google yorumu · 3 yıl sonunda</span></figcaption></figure></div></section><section class="mx-auto max-w-3xl px-6 pb-14"><h2 class="text-3xl text-ink">Sıkça Sorulanlar</h2><dl class="mt-8 space-y-6"><div class="border-t border-rule pt-6"><dt class="font-medium text-ink">Hangi yaş gruplarını kabul ediyorsunuz?</dt><dd class="mt-2 text-ink-soft">İki yaşından beş yaşının sonuna kadar dört grubumuz var: 2-3, 3-4, 4-5 ve 5-6 yaş.</dd></div><div class="border-t border-rule pt-6"><dt class="font-medium text-ink">Sınıf mevcudunuz kaç?</dt><dd class="mt-2 text-ink-soft">Sınıflarımızda 13 çocuk ve 2 öğretmen bulunur — öğretmen başına 7 çocuk düşer.</dd></div><div class="border-t border-rule pt-6"><dt class="font-medium text-ink">Ücret bilgisini nasıl alabilirim?</dt><dd class="mt-2 text-ink-soft">Ücreti ön görüşmede yazılı olarak paylaşıyoruz; programa, gün sayısına ve servis ihtiyacına göre değiştiği için sitede tek bir rakam yayımlamıyoruz.</dd></div><div class="border-t border-rule pt-6"><dt class="font-medium text-ink">Okulu gezebilir miyim?</dt><dd class="mt-2 text-ink-soft">Evet. Ön görüşme randevunuzda ders saatinde gelip sınıfı görebilirsiniz; kayıt zorunluluğu yoktur.</dd></div></dl></section><section class="border-t border-rule bg-paper-warm py-14"><div class="mx-auto max-w-3xl px-6 text-center"><h2 class="text-3xl text-ink">Okulu gezin, sonra karar verin</h2><p class="mt-4 text-ink-soft">Cumhuriyet Mahallesi, Uludağ Sokak No:6, Beykent, Büyükçekmece/İstanbul</p><div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row"><a href="#form" class="rounded-full bg-ink px-8 py-4 text-paper">Ön Görüşme Randevusu</a><a href="tel:+905301018875" class="rounded-full border border-ink px-8 py-4 text-ink">0530 101 88 75</a><a href="https://maps.google.com/?q=Cumhuriyet%20Mahallesi%2C%20Uluda%C4%9F%20Sokak%20No%3A6%20Beykent%2C%20B%C3%BCy%C3%BCk%C3%A7ekmece%2F%C4%B0stanbul" target="_blank" rel="noopener noreferrer" class="rounded-full border border-ink px-8 py-4 text-ink">Haritada Gör</a></div></div></section></div>"`;

exports[`reklam sayfaları ziyaretçi HTML > beylikduzu-anaokulu: düzenleme katmanından önceki hâliyle aynı 1`] = `"<div class="bg-paper"><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Beylikdüzü'nden servis var mı?","acceptedAnswer":{"@type":"Answer","text":"Hizmet bölgemiz Beylikdüzü'nü kapsar. Servis ihtiyacınız varsa güzergâhı ve saatleri adresinize göre ön görüşmede birlikte planlıyoruz."}},{"@type":"Question","name":"Yol ne kadar sürüyor?","acceptedAnswer":{"@type":"Answer","text":"Beykent, Beylikdüzü'ye komşu bir bölge. Kesin süre adresinize göre değişir; ön görüşmede birlikte bakabiliriz."}},{"@type":"Question","name":"Hangi yaş gruplarını kabul ediyorsunuz?","acceptedAnswer":{"@type":"Answer","text":"İki yaşından beş yaşının sonuna kadar dört grubumuz var: 2-3, 3-4, 4-5 ve 5-6 yaş."}},{"@type":"Question","name":"Ücret bilgisini nasıl alabilirim?","acceptedAnswer":{"@type":"Answer","text":"Ücreti ön görüşmede yazılı olarak paylaşıyoruz; programa, gün sayısına ve servis ihtiyacına göre değiştiği için sitede tek bir rakam yayımlamıyoruz."}}]}</script><section><div class="mx-auto max-w-6xl lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,420px)] lg:items-start lg:gap-12 lg:px-6 lg:pt-10 lg:pb-16"><div class="flex min-w-0 flex-col"><div class="relative aspect-[3/2] overflow-hidden bg-paper-warm min-[375px]:aspect-[4/3] lg:order-2 lg:mt-7 lg:aspect-[3/2] lg:rounded-[28px]"><img alt="Şeker Anaokulu bahçesi: çim alan, ağaçlar, ahşap oyun evi ve piknik masası" fetchpriority="high" loading="eager" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; color: transparent;" sizes="(min-width: 1152px) 690px, (min-width: 1024px) 60vw, 100vw" srcset="/_next/image?url=%2Fbahce-genis.webp&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fbahce-genis.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fbahce-genis.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fbahce-genis.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fbahce-genis.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fbahce-genis.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fbahce-genis.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fbahce-genis.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fbahce-genis.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fbahce-genis.webp&amp;w=3840&amp;q=75"><div aria-hidden="true" class="scallop absolute inset-x-0 -bottom-px lg:hidden"></div></div><div class="px-5 pt-4 sm:px-6 lg:order-1 lg:px-0 lg:pt-0"><h1 class="lp-title text-balance text-ink">Çocuğunuz İçin Beykent’in Merkezinde, Güvenle Büyüyeceği Bir Gelecek</h1><p class="lp-lede mt-2.5 max-w-[60ch] whitespace-pre-line text-ink-soft lg:mt-4">Beykent’teyiz, Beylikdüzü’ne komşuyuz. Servis güzergâhını ve saatlerini adresinize göre ön görüşmede birlikte planlıyoruz; gelin, okulu ve bahçeyi gezin.</p><a href="#form" class="mt-4 flex min-h-12 items-center justify-center rounded-full bg-grape px-6 text-base font-semibold text-white shadow-md shadow-grape/25 lg:hidden">Ön Görüşme Randevusu</a></div><div class="px-5 sm:px-6 lg:order-3 lg:px-0"><dl class="mt-6 grid grid-cols-3 border-y border-rule py-4 sm:grid-cols-4 lg:mt-7"><div class="min-w-0 border-l border-rule px-3 first:border-l-0 first:pl-0 "><dt class="font-display text-[1.375rem] leading-none font-semibold text-ink lg:text-[1.625rem]">15 yıl</dt><dd class="mt-1.5 text-[13px] leading-snug text-ink-soft">Beykent'te aynı adreste</dd></div><div class="min-w-0 border-l border-rule px-3 first:border-l-0 first:pl-0 "><dt class="font-display text-[1.375rem] leading-none font-semibold text-ink lg:text-[1.625rem]">13</dt><dd class="mt-1.5 text-[13px] leading-snug text-ink-soft">Sınıf mevcudu</dd></div><div class="min-w-0 border-l border-rule px-3 first:border-l-0 first:pl-0 "><dt class="font-display text-[1.375rem] leading-none font-semibold text-ink lg:text-[1.625rem]">1 : 7</dt><dd class="mt-1.5 text-[13px] leading-snug text-ink-soft">Öğretmen başına çocuk</dd></div><div class="min-w-0 border-l border-rule px-3 first:border-l-0 first:pl-0 hidden sm:block"><dt class="font-display text-[1.375rem] leading-none font-semibold text-ink lg:text-[1.625rem]">6</dt><dd class="mt-1.5 text-[13px] leading-snug text-ink-soft">Hizmet verdiğimiz bölge</dd></div></dl><ul class="mt-6 grid gap-3 lg:mt-7 lg:grid-cols-2 lg:gap-4"><li class="min-w-0"><figure class="h-full rounded-2xl border border-rule bg-white px-4 py-4 lg:px-5"><svg aria-hidden="true" viewBox="0 0 100 20" class="block h-3.5 w-[70px] shrink-0 fill-[#E9A100]"><path transform="translate(0 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(20 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(40 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(60 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(80 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path></svg><blockquote class="mt-2.5 text-[15px] leading-relaxed text-ink">“Şu an 4 yaşında olan kızımız için 1,5 yıl içinde 3 farklı yer denedik. Daha köklü ve iyi olur diye kolej anaokuluna bile gönderdik. Sonunda burada karar kıldık.”</blockquote><figcaption class="mt-3 text-[13px] leading-snug text-ink-soft"><span class="font-bold text-ink">Emre</span><span class="block">Google yorumu · 4 yaş velisi</span></figcaption></figure></li><li class="min-w-0"><figure class="h-full rounded-2xl border border-rule bg-white px-4 py-4 lg:px-5"><svg aria-hidden="true" viewBox="0 0 100 20" class="block h-3.5 w-[70px] shrink-0 fill-[#E9A100]"><path transform="translate(0 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(20 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(40 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(60 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(80 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path></svg><blockquote class="mt-2.5 text-[15px] leading-relaxed text-ink">“Şu an ortaokulda olan büyük kızımla 2012’de başlayan Şeker Akademi maceram, 2021’de küçük kızımla devam etti. Bu yıl o da mezun oluyor. Hiç pişman olmadım.”</blockquote><figcaption class="mt-3 text-[13px] leading-snug text-ink-soft"><span class="font-bold text-ink">Arzu Ö.</span><span class="block">Google yorumu · iki çocuğunu da gönderen veli</span></figcaption></figure></li></ul></div></div><div id="form" class="mt-8 scroll-mt-3 border-t border-rule bg-paper-warm px-5 pt-8 pb-10 sm:px-6 lg:sticky lg:top-6 lg:mt-0 lg:rounded-[28px] lg:border lg:bg-white lg:p-8 lg:shadow-[0_18px_50px_-24px_rgb(46_16_101/0.35)]"><h2 class="text-[1.625rem] text-ink lg:text-[1.5rem]">Bir kere gelin, farkı görün</h2><p class="mt-1.5 text-[15px] text-ink-soft">Size uygun bir saat seçin. Kayıt zorunluluğu yok.</p><div class="mt-6"><form novalidate="" class="space-y-5"><input readonly="" type="hidden" value="" name="gclid"><input readonly="" type="hidden" value="" name="fbclid"><input readonly="" type="hidden" value="" name="fbc"><input readonly="" type="hidden" value="" name="fbp"><input readonly="" type="hidden" value="/" name="landingPath"><input readonly="" type="hidden" value="" name="utm_source"><input readonly="" type="hidden" value="" name="utm_medium"><input readonly="" type="hidden" value="" name="utm_campaign"><input readonly="" type="hidden" value="" name="utm_term"><input readonly="" type="hidden" value="" name="utm_content"><div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden"><label for="website">Web siteniz</label><input id="website" tabindex="-1" autocomplete="off" type="text" name="website"></div><div class="grid gap-5 md:grid-cols-2"><div><label for="parentName" class="mb-1.5 block text-sm font-semibold text-ink">Adınız</label><input id="parentName" autocomplete="name" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark" required="" name="parentName"></div><div><label for="phone" class="mb-1.5 block text-sm font-semibold text-ink">Telefon numaranız</label><input id="phone" inputmode="tel" autocomplete="tel" placeholder="05XX XXX XX XX" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark" required="" type="tel" name="phone"></div></div><fieldset><legend class="mb-1.5 block text-sm font-semibold text-ink">Çocuğunuzun doğum ayı ve yılı</legend><div class="grid grid-cols-2 gap-3"><div><label for="childBirthMonth" class="sr-only">Doğum ayı</label><select id="childBirthMonth" name="childBirthMonth" required="" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark min-h-[44px]"><option value="">Ay</option><option value="1">Ocak</option><option value="2">Şubat</option><option value="3">Mart</option><option value="4">Nisan</option><option value="5">Mayıs</option><option value="6">Haziran</option><option value="7">Temmuz</option><option value="8">Ağustos</option><option value="9">Eylül</option><option value="10">Ekim</option><option value="11">Kasım</option><option value="12">Aralık</option></select></div><div><label for="childBirthYear" class="sr-only">Doğum yılı</label><select id="childBirthYear" name="childBirthYear" required="" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark min-h-[44px]"><option value="">Yıl</option><option value="2026">2026</option><option value="2025">2025</option><option value="2024">2024</option><option value="2023">2023</option><option value="2022">2022</option><option value="2021">2021</option><option value="2020">2020</option><option value="2019">2019</option></select></div></div></fieldset><div><label for="district" class="mb-1.5 block text-sm font-semibold text-ink">Oturduğunuz semt</label><select id="district" name="district" required="" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark min-h-[44px]"><option value="">Seçin</option><option value="Beykent">Beykent</option><option value="Beylikdüzü">Beylikdüzü</option><option value="Büyükçekmece">Büyükçekmece</option><option value="Esenyurt">Esenyurt</option><option value="Gürpınar">Gürpınar</option><option value="Yakuplu">Yakuplu</option><option value="Diğer">Diğer</option></select></div><fieldset><legend class="mb-1.5 block text-sm font-semibold text-ink">Ne zaman başlamayı düşünüyorsunuz?</legend><div class="grid gap-2 sm:grid-cols-2"><label class="flex min-h-[44px] items-center gap-3 rounded-xl border-2 border-rule bg-white px-4 py-2 text-ink"><input required="" class="h-5 w-5" type="radio" value="hemen" name="startWindow"><span>Hemen</span></label><label class="flex min-h-[44px] items-center gap-3 rounded-xl border-2 border-rule bg-white px-4 py-2 text-ink"><input required="" class="h-5 w-5" type="radio" value="1_3_ay" name="startWindow"><span>1–3 ay içinde</span></label><label class="flex min-h-[44px] items-center gap-3 rounded-xl border-2 border-rule bg-white px-4 py-2 text-ink"><input required="" class="h-5 w-5" type="radio" value="3_6_ay" name="startWindow"><span>3–6 ay içinde</span></label><label class="flex min-h-[44px] items-center gap-3 rounded-xl border-2 border-rule bg-white px-4 py-2 text-ink"><input required="" class="h-5 w-5" type="radio" value="gelecek_yil" name="startWindow"><span>Gelecek eğitim yılı</span></label></div></fieldset><label class="flex min-h-[44px] items-center gap-3 text-ink"><input class="h-5 w-5" type="checkbox" name="wantsWhatsapp"><span>WhatsApp'tan yazmamızı ister misiniz?</span></label><label class="flex items-start gap-3 text-sm text-ink-soft"><input required="" class="mt-1 h-4 w-4" type="checkbox" name="kvkkConsent"><span><a href="/gizlilik" class="underline">KVKK Aydınlatma Metni</a>'ni okudum. Başvurum için aranmama ve başvuru bilgilerimin reklamlarımızın etkinliğini ölçmek amacıyla Google ile paylaşılmasına onay veriyorum.</span></label><button type="submit" class="w-full rounded-full bg-grape px-8 py-4 text-lg font-semibold text-white shadow-lg shadow-grape/30 transition hover:bg-ink disabled:opacity-60">Beni Arayın</button><p class="text-center text-sm text-ink-soft">Numaranızı bırakın, <strong>15 dakika</strong> içinde sizi arayalım.</p></form></div></div></div></section><div class="mx-auto max-w-5xl px-5 pt-12 sm:px-6"><div class="relative w-full overflow-hidden rounded-3xl bg-paper-warm ring-1 ring-rule aspect-[3/2]"><img alt="Bahçedeki ahşap mutfak atölyesi, açık hava sınıfı ve ağacı çevreleyen oturma bankı" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; color: transparent;" sizes="(max-width: 768px) 100vw, 1100px" srcset="/_next/image?url=%2Fbahce-atolyeler.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fbahce-atolyeler.webp&amp;w=3840&amp;q=75"></div></div><section class="mx-auto max-w-3xl px-6 py-14"><div class="mb-10 last:mb-0"><h2 class="text-2xl text-ink">Neden mahalledeki okul değil</h2><p class="mt-3 text-ink-soft">Okul öncesinde belirleyici olan mesafe değil, öğretmen başına düşen çocuk sayısıdır. Sınıflarımızda 13 çocuk ve 2 öğretmen bulunur — öğretmen başına 7 çocuk düşer.</p></div><div class="mb-10 last:mb-0"><h2 class="text-2xl text-ink">Servis ihtiyacınızı birlikte planlıyoruz</h2><p class="mt-3 text-ink-soft">Güzergâh ve saatler kayıtlı ailelerin adreslerine göre şekillenir; bu yüzden siteye tek bir hat yazmak yerine, adresinizin uygunluğunu ön görüşmede birlikte değerlendiriyoruz.</p></div><div class="mb-10 last:mb-0"><h2 class="text-2xl text-ink">Haftanın 5 günü Montessori</h2><p class="mt-3 text-ink-soft">Montessori çalışması bizde ayrı bir etkinlik saati değil, haftanın 5 günü günün omurgasıdır. Materyaller açık raflarda, çocuğun boyunda durur; öğretmen araya girmez, gözlemler. Bu yaklaşımın işlemesi sınıf mevcudunun sınırlı tutulmasına bağlıdır.</p></div></section><section class="mx-auto max-w-4xl px-6 pb-14"><div class="grid gap-4 md:grid-cols-2"><figure class="h-full rounded-2xl border border-rule bg-white px-4 py-4 lg:px-5"><svg aria-hidden="true" viewBox="0 0 100 20" class="block h-3.5 w-[70px] shrink-0 fill-[#E9A100]"><path transform="translate(0 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(20 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(40 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(60 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(80 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path></svg><blockquote class="mt-2.5 text-[15px] leading-relaxed text-ink">“Okul öncesi eğitimin kapsamlı olduğu, velinin neredeyse her an hem telefonla hem uygulamadan bilgilendirildiği, öğretmenlerin güler yüzlü olduğu beş yıldızlık bir okul.”</blockquote><figcaption class="mt-3 text-[13px] leading-snug text-ink-soft"><span class="font-bold text-ink">Ece P.</span><span class="block">Google yorumu</span></figcaption></figure><figure class="h-full rounded-2xl border border-rule bg-white px-4 py-4 lg:px-5"><svg aria-hidden="true" viewBox="0 0 100 20" class="block h-3.5 w-[70px] shrink-0 fill-[#E9A100]"><path transform="translate(0 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(20 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(40 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(60 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path><path transform="translate(80 0)" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path></svg><blockquote class="mt-2.5 text-[15px] leading-relaxed text-ink">“3 yılın sonunda akademik olarak branş derslerinde iyi olan, daha önemlisi kendini rahat ifade edebilen, hakkını arayan, hayvan seven, yemek seçmeyen, sosyal kurallara uyan bir çocuğum var.”</blockquote><figcaption class="mt-3 text-[13px] leading-snug text-ink-soft"><span class="font-bold text-ink">Yonca M.</span><span class="block">Google yorumu · 3 yıl sonunda</span></figcaption></figure></div></section><section class="mx-auto max-w-3xl px-6 pb-14"><h2 class="text-3xl text-ink">Sıkça Sorulanlar</h2><dl class="mt-8 space-y-6"><div class="border-t border-rule pt-6"><dt class="font-medium text-ink">Beylikdüzü'nden servis var mı?</dt><dd class="mt-2 text-ink-soft">Hizmet bölgemiz Beylikdüzü'nü kapsar. Servis ihtiyacınız varsa güzergâhı ve saatleri adresinize göre ön görüşmede birlikte planlıyoruz.</dd></div><div class="border-t border-rule pt-6"><dt class="font-medium text-ink">Yol ne kadar sürüyor?</dt><dd class="mt-2 text-ink-soft">Beykent, Beylikdüzü'ye komşu bir bölge. Kesin süre adresinize göre değişir; ön görüşmede birlikte bakabiliriz.</dd></div><div class="border-t border-rule pt-6"><dt class="font-medium text-ink">Hangi yaş gruplarını kabul ediyorsunuz?</dt><dd class="mt-2 text-ink-soft">İki yaşından beş yaşının sonuna kadar dört grubumuz var: 2-3, 3-4, 4-5 ve 5-6 yaş.</dd></div><div class="border-t border-rule pt-6"><dt class="font-medium text-ink">Ücret bilgisini nasıl alabilirim?</dt><dd class="mt-2 text-ink-soft">Ücreti ön görüşmede yazılı olarak paylaşıyoruz; programa, gün sayısına ve servis ihtiyacına göre değiştiği için sitede tek bir rakam yayımlamıyoruz.</dd></div></dl></section><section class="border-t border-rule bg-paper-warm py-14"><div class="mx-auto max-w-3xl px-6 text-center"><h2 class="text-3xl text-ink">Okulu gezin, sonra karar verin</h2><p class="mt-4 text-ink-soft">Cumhuriyet Mahallesi, Uludağ Sokak No:6, Beykent, Büyükçekmece/İstanbul</p><div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row"><a href="#form" class="rounded-full bg-ink px-8 py-4 text-paper">Ön Görüşme Randevusu</a><a href="tel:+905301018875" class="rounded-full border border-ink px-8 py-4 text-ink">0530 101 88 75</a><a href="https://maps.google.com/?q=Cumhuriyet%20Mahallesi%2C%20Uluda%C4%9F%20Sokak%20No%3A6%20Beykent%2C%20B%C3%BCy%C3%BCk%C3%A7ekmece%2F%C4%B0stanbul" target="_blank" rel="noopener noreferrer" class="rounded-full border border-ink px-8 py-4 text-ink">Haritada Gör</a></div></div></section></div>"`;

