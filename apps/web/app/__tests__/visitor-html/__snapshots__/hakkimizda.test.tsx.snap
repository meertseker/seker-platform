// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`hakkimizda ziyaretçi HTML > düzenleme katmanından önceki hâliyle aynı 1`] = `"<div class="min-h-screen bg-paper"><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Ana Sayfa","item":"https://sekeranaokulu.com/"},{"@type":"ListItem","position":2,"name":"Hakkımızda","item":"https://sekeranaokulu.com/hakkimizda"}]}</script><section class="band-bubble relative overflow-hidden pb-16 pt-14 md:pb-20 md:pt-20"><div aria-hidden="true" class="pointer-events-none absolute inset-0"><span class="confetti-float absolute left-[6%] top-8 h-16 w-16 rounded-full bg-sunny/25"></span><span class="confetti-float absolute right-[8%] top-6 h-24 w-24 rounded-full bg-bubble/20"></span><span class="confetti-float absolute right-[22%] bottom-12 h-10 w-10 rotate-12 rounded-xl bg-mint/25"></span><span class="confetti-float absolute left-[18%] bottom-10 h-8 w-8 rotate-45 rounded-md bg-sky/25"></span><span class="confetti-float absolute left-[46%] top-4 h-6 w-6 rounded-full bg-white/20"></span></div><div class="relative z-10 mx-auto max-w-3xl px-6 text-center"><p class="timecode text-white/70">2011'den beri Beykent'te</p><h1 class="mt-4 font-display text-3xl text-white md:text-5xl">Beykent'in en köklü anaokullarından biriyiz.</h1><p class="mx-auto mt-5 max-w-2xl text-base text-white/85 md:text-lg">Yıllara dayanan eğitim deneyimimizi, çocukları tanıyan ve her çocuğun kendini değerli hissettiği bir okul anlayışıyla sürdürüyoruz. Çocukların akademik gelişiminin yanı sıra sosyal, duygusal ve bilişsel gelişimlerini de destekliyoruz.</p></div><div aria-hidden="true" class="absolute inset-x-0 bottom-0 scallop"></div></section><section class="py-12"><div class="mx-auto max-w-5xl px-4 md:px-6"><div class="grid grid-cols-2 gap-4 md:grid-cols-4"><div class="rounded-3xl bg-white p-6 text-center shadow-sm ring-1 ring-rule"><p class="font-display text-3xl text-grape">2011</p><p class="mt-1 text-sm text-ink-soft">Kuruluş yılı</p></div><div class="rounded-3xl bg-white p-6 text-center shadow-sm ring-1 ring-rule"><p class="font-display text-3xl text-bubble-deep">15 yıl</p><p class="mt-1 text-sm text-ink-soft">Aynı bölgede</p></div><div class="rounded-3xl bg-white p-6 text-center shadow-sm ring-1 ring-rule"><p class="font-display text-3xl text-grape">2</p><p class="mt-1 text-sm text-ink-soft">Ayrı bina</p></div><div class="rounded-3xl bg-white p-6 text-center shadow-sm ring-1 ring-rule"><p class="font-display text-3xl text-bubble-deep">2</p><p class="mt-1 text-sm text-ink-soft">Büyük bahçe</p></div></div></div></section><section class="py-16"><div class="container mx-auto px-4 md:px-6"><div class="mb-12 text-center"><h2 class="font-display text-3xl text-ink md:text-4xl">Değerlerimiz</h2><p class="mx-auto mt-4 max-w-2xl text-ink-soft">Sevgi, güven ve aidiyet duygusunu merkeze alan bir okul ortamı kurmaya çalışıyoruz. Montessori yaklaşımımız ve branş derslerimizle çocukların özgüvenlerini, yeteneklerini ve bağımsızlıklarını destekliyoruz.</p></div><div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4"><div class="card-lift rounded-3xl bg-white p-6 text-center shadow-sm ring-1 ring-rule"><div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-bubble-deep"><svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg></div><h3 class="mb-2 font-display text-xl text-ink">Sevgi</h3><p class="text-sm leading-relaxed text-ink-soft">Çocuğun kendini burada değerli hissetmesi, öğrenmenin ön koşulu. Her şeyden önce bunu kuruyoruz.</p></div><div class="card-lift rounded-3xl bg-white p-6 text-center shadow-sm ring-1 ring-rule"><div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-mint-deep"><svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div><h3 class="mb-2 font-display text-xl text-ink">Güven</h3><p class="text-sm leading-relaxed text-ink-soft">Çıkışta öğretmeni size günü anlatır, gün içinde merak ettiğinizde bakabilirsiniz. Anlatmadığımız bir şey olmuyor.</p></div><div class="card-lift rounded-3xl bg-white p-6 text-center shadow-sm ring-1 ring-rule"><div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-grape"><svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg></div><h3 class="mb-2 font-display text-xl text-ink">Aidiyet</h3><p class="text-sm leading-relaxed text-ink-soft">Çocuk kendi sınıfını, kendi öğretmenini ve kendi köşesini tanır. Yıl ortasında öğretmen değiştirmiyoruz.</p></div><div class="card-lift rounded-3xl bg-white p-6 text-center shadow-sm ring-1 ring-rule"><div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-tangerine-deep"><svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg></div><h3 class="mb-2 font-display text-xl text-ink">Bağımsızlık</h3><p class="text-sm leading-relaxed text-ink-soft">Montessori çalışmasının hedefi bu: çocuk kendi işini seçsin, kendi hızında bitirsin, yerine kaldırsın.</p></div></div></div></section><section id="guvenlik" class="scroll-mt-24 bg-paper-warm py-16"><div class="mx-auto max-w-4xl px-4 md:px-6"><div class="mb-12 text-center"><span class="timecode text-grape ">Güvenlik ve Sağlık</span><h2 class="mt-2 font-display text-3xl text-ink md:text-4xl">Çocuğunuzun güvenliği, tesadüfe bırakılmaz.</h2></div><div class="grid gap-6 md:grid-cols-2"><div class="card-lift overflow-hidden rounded-3xl bg-white shadow-sm"><div class="h-1.5 bg-grape"></div><div class="p-6 md:p-8"><h3 class="font-display text-xl text-ink">Okulcep ile gün içinde bilgilendirme</h3><p class="mt-3 text-ink-soft">Çocuğunuzun gün içindeki anlarını Okulcep uygulamamız üzerinden takip edebilirsiniz. Öğretmenlerimiz gün içinde mesaj, fotoğraf ve video paylaşarak sizi bilgilendirir.</p></div></div><div class="card-lift overflow-hidden rounded-3xl bg-white shadow-sm"><div class="h-1.5 bg-mint"></div><div class="p-6 md:p-8"><h3 class="font-display text-xl text-ink">Gözetim altındaki iki bahçe</h3><p class="mt-3 text-ink-soft">Çocuklar günün büyük bölümünü bahçede geçiriyor. İki bahçemiz de kapalı ve gözetim altında; oyun alanları öğretmenin görebileceği mesafede kurulu. Çocuk kendi oyununu kurar, öğretmen gözler ve gerektiğinde araya girer.</p></div></div><div class="card-lift overflow-hidden rounded-3xl bg-white shadow-sm"><div class="h-1.5 bg-sky"></div><div class="p-6 md:p-8"><h3 class="font-display text-xl text-ink">Günü birlikte kapatıyoruz</h3><p class="mt-3 text-ink-soft">Her çocuk alınırken öğretmeni size o günü anlatır: ne yaptı, neyi zor buldu, neye ilk kez cesaret etti. Çocuğunuzu kimin alacağı değişecekse bunu önceden bize bildirmeniz gerekiyor.</p></div></div><div class="card-lift overflow-hidden rounded-3xl bg-white shadow-sm"><div class="h-1.5 bg-bubble"></div><div class="p-6 md:p-8"><h3 class="font-display text-xl text-ink">Okulun kendi mutfağı</h3><p class="mt-3 text-ink-soft">Yemeklerimiz okulun kendi mutfağında, her gün taze olarak hazırlanıyor. Aylık yemek listesini velilerimizle önceden paylaşıyoruz. Çocuğunuzun alerjisi ya da özel bir beslenme durumu varsa kayıt sırasında not alıyor ve mutfağa iletiyoruz.</p></div></div><div class="card-lift overflow-hidden rounded-3xl bg-white shadow-sm"><div class="h-1.5 bg-grape"></div><div class="p-6 md:p-8"><h3 class="font-display text-xl text-ink">Uzman psikolog desteği</h3><p class="mt-3 text-ink-soft">Okulumuzda görev yapan uzman psikoloğumuzla çocuklarımızın sosyal ve duygusal gelişimini de destekliyoruz. İhtiyaç hâlinde velilerimiz randevu oluşturarak uzman psikoloğumuzdan bireysel görüşme desteği alabiliyor.</p></div></div><div class="card-lift overflow-hidden rounded-3xl bg-white shadow-sm"><div class="h-1.5 bg-mint"></div><div class="p-6 md:p-8"><h3 class="font-display text-xl text-ink">Servis</h3><p class="mt-3 text-ink-soft">Beykent, Beylikdüzü, Mimaroba, Gürpınar, Yakuplu, Büyükçekmece taraflarına servisimiz var. Güzergâh ve saatler kayıtlı ailelerin adreslerine göre şekillendiği için, adresinizin uygunluğunu ön görüşmede birlikte değerlendiriyoruz.</p></div></div></div></div></section><section id="randevu" class="bg-paper relative scroll-mt-24 overflow-hidden py-14 md:py-20"><div aria-hidden="true" class="pointer-events-none absolute inset-0"><span class="confetti-float absolute -right-12 top-10 h-40 w-40 rounded-full bg-grape/10"></span><span class="confetti-float absolute -left-10 bottom-16 h-32 w-32 rounded-full bg-sunny/15"></span></div><div class="relative z-10 mx-auto max-w-2xl px-4 md:px-6"><div class="text-center"><h2 class="mt-2 font-display text-2xl text-ink md:text-3xl">Okulu gezmeye gelin</h2><p class="mx-auto mt-3 max-w-xl text-ink-soft">Haftanın 5 günü Montessori çalışıyoruz. Randevunuzu çalışma saatine alalım, sınıfı iş üstünde görün.</p></div><div class="mt-8 rounded-3xl bg-white p-5 shadow-lg shadow-ink/5 md:p-8 "><form novalidate="" class="space-y-5"><input readonly="" type="hidden" value="" name="gclid"><input readonly="" type="hidden" value="" name="fbclid"><input readonly="" type="hidden" value="" name="fbc"><input readonly="" type="hidden" value="" name="fbp"><input readonly="" type="hidden" value="/" name="landingPath"><input readonly="" type="hidden" value="" name="utm_source"><input readonly="" type="hidden" value="" name="utm_medium"><input readonly="" type="hidden" value="" name="utm_campaign"><input readonly="" type="hidden" value="" name="utm_term"><input readonly="" type="hidden" value="" name="utm_content"><div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden"><label for="website">Web siteniz</label><input id="website" tabindex="-1" autocomplete="off" type="text" name="website"></div><div class="grid gap-5 md:grid-cols-2"><div><label for="parentName" class="mb-1.5 block text-sm font-semibold text-ink">Adınız</label><input id="parentName" autocomplete="name" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark" required="" name="parentName"></div><div><label for="phone" class="mb-1.5 block text-sm font-semibold text-ink">Telefon numaranız</label><input id="phone" inputmode="tel" autocomplete="tel" placeholder="05XX XXX XX XX" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark" required="" type="tel" name="phone"></div></div><label class="flex items-start gap-3 text-sm text-ink-soft"><input required="" class="mt-1 h-4 w-4" type="checkbox" name="kvkkConsent"><span><a href="/gizlilik" class="underline">KVKK Aydınlatma Metni</a>'ni okudum. Başvurum için aranmama ve başvuru bilgilerimin reklamlarımızın etkinliğini ölçmek amacıyla Google ile paylaşılmasına onay veriyorum.</span></label><button type="submit" class="w-full rounded-full bg-grape px-8 py-4 text-lg font-semibold text-white shadow-lg shadow-grape/30 transition hover:bg-ink disabled:opacity-60">Beni Arayın</button><p class="text-center text-sm text-ink-soft">Numaranızı bırakın, <strong>15 dakika</strong> içinde sizi arayalım.</p></form></div></div></section></div>"`;
