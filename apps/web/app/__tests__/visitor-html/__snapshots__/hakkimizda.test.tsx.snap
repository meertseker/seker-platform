// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`hakkimizda ziyaretçi HTML > TrustBar: düzenleme katmanından önceki hâliyle aynı 1`] = `"<section class="hidden px-6 pb-4 md:block"><div class="mx-auto flex max-w-6xl flex-wrap justify-center gap-4 rounded-3xl bg-paper-warm px-6 py-8"><div class="min-w-48 flex-1 rounded-2xl bg-white px-6 py-5 text-center shadow-sm"><p class="font-display text-2xl md:text-3xl text-grape">13</p><p class="mt-1 text-xs text-ink-soft md:mt-2 md:text-sm">Sınıfta çocuk</p></div><div class="min-w-48 flex-1 rounded-2xl bg-white px-6 py-5 text-center shadow-sm"><p class="font-display text-2xl md:text-3xl text-bubble-deep">2</p><p class="mt-1 text-xs text-ink-soft md:mt-2 md:text-sm">Her sınıfta öğretmen</p></div><div class="min-w-48 flex-1 rounded-2xl bg-white px-6 py-5 text-center shadow-sm"><p class="font-display text-2xl md:text-3xl text-grape">2 saat</p><p class="mt-1 text-xs text-ink-soft md:mt-2 md:text-sm">Her gün İngilizce</p></div><div class="min-w-48 flex-1 rounded-2xl bg-white px-6 py-5 text-center shadow-sm"><p class="font-display text-2xl md:text-3xl text-bubble-deep">15 yıl</p><p class="mt-1 text-xs text-ink-soft md:mt-2 md:text-sm">Beykent'te aynı adreste</p></div></div></section>"`;

exports[`hakkimizda ziyaretçi HTML > düzenleme katmanından önceki hâliyle aynı 1`] = `"<div class="min-h-screen bg-paper"><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Ana Sayfa","item":"https://sekeranaokulu.com/"},{"@type":"ListItem","position":2,"name":"Hakkımızda","item":"https://sekeranaokulu.com/hakkimizda"}]}</script><section class="band-bubble relative overflow-hidden pb-16 pt-14 md:pb-20 md:pt-20"><div aria-hidden="true" class="pointer-events-none absolute inset-0"><span class="confetti-float absolute left-[6%] top-8 h-16 w-16 rounded-full bg-sunny/25"></span><span class="confetti-float absolute right-[8%] top-6 h-24 w-24 rounded-full bg-bubble/20"></span><span class="confetti-float absolute right-[22%] bottom-12 h-10 w-10 rotate-12 rounded-xl bg-mint/25"></span><span class="confetti-float absolute left-[18%] bottom-10 h-8 w-8 rotate-45 rounded-md bg-sky/25"></span><span class="confetti-float absolute left-[46%] top-4 h-6 w-6 rounded-full bg-white/20"></span></div><div class="relative z-10 mx-auto max-w-3xl px-6 text-center"><p class="timecode text-white/70">2011'den beri Beykent'te</p><h1 class="mt-4 font-display text-3xl text-white md:text-5xl">Beykent'in en köklü anaokullarından biriyiz.</h1><p class="mx-auto mt-5 max-w-2xl text-base text-white/85 md:text-lg">Yıllara dayanan eğitim deneyimimizi, çocukları tanıyan ve her çocuğun kendini değerli hissettiği bir okul anlayışıyla sürdürüyoruz. Çocukların akademik gelişiminin yanı sıra sosyal, duygusal ve bilişsel gelişimlerini de destekliyoruz.</p></div><div aria-hidden="true" class="absolute inset-x-0 bottom-0 scallop"></div></section><section class="py-12"><div class="mx-auto max-w-5xl px-6"><div class="grid grid-cols-2 gap-4 md:grid-cols-4"><div class="rounded-3xl bg-white p-6 text-center shadow-sm ring-1 ring-rule"><p class="font-display text-3xl text-grape">2011</p><p class="mt-1 text-sm text-ink-soft">Kuruluş yılı</p></div><div class="rounded-3xl bg-white p-6 text-center shadow-sm ring-1 ring-rule"><p class="font-display text-3xl text-bubble-deep">15 yıl</p><p class="mt-1 text-sm text-ink-soft">Aynı bölgede</p></div><div class="rounded-3xl bg-white p-6 text-center shadow-sm ring-1 ring-rule"><p class="font-display text-3xl text-grape">2</p><p class="mt-1 text-sm text-ink-soft">Ayrı bina</p></div><div class="rounded-3xl bg-white p-6 text-center shadow-sm ring-1 ring-rule"><p class="font-display text-3xl text-bubble-deep">2</p><p class="mt-1 text-sm text-ink-soft">Büyük bahçe</p></div></div></div></section><div class="pb-16"><div class="container mx-auto px-4 md:px-6"><div class="flex flex-col items-center gap-8 md:flex-row md:gap-16"><div class="relative order-2 hidden md:block md:w-1/2 md:order-2"><div aria-hidden="true" class="absolute -z-10 right-0 bottom-0 h-3/4 w-3/4 rounded-full bg-mint/50"></div><div aria-hidden="true" class="absolute right-8 top-8 z-10 hidden flex-col gap-2 sm:flex"><div class="flex gap-2"><div class="flex h-10 w-10 items-center justify-center rounded-full bg-bubble"><div class="h-4 w-4 rounded-full bg-white"></div></div><div class="flex h-10 w-10 items-center justify-center rounded-xl bg-grape"><div class="mr-1 h-2 w-2 rounded-full bg-white"></div><div class="ml-1 h-2 w-2 rounded-full bg-white"></div></div></div><div class="flex gap-2"><div class="h-10 w-10 rounded-xl bg-sunny"></div><div class="h-10 w-10 rotate-45 rounded-xl bg-sky"></div></div></div><img alt="Şeker Anaokulu bahçesi: çim alan, ağaçlar, ahşap oyun evi ve piknik masası" loading="lazy" width="400" height="400" decoding="async" data-nimg="1" class="relative z-0 h-auto w-full max-w-md rounded-3xl object-cover shadow-lg shadow-ink/10" style="color: transparent;" srcset="/_next/image?url=%2Fbahce-genis.webp&amp;w=640&amp;q=75 1x, /_next/image?url=%2Fbahce-genis.webp&amp;w=828&amp;q=75 2x" src="/_next/image?url=%2Fbahce-genis.webp&amp;w=828&amp;q=75"></div><div class="order-1 md:w-1/2 md:order-1"><h2 class="mb-4 font-display text-2xl text-ink md:text-3xl">İki binamız, iki büyük bahçemiz var</h2><p class="mb-6 text-ink-soft">Geniş metrekareye sahip iki bahçemizle çocukların özgürce hareket edebildiği, keşfedebildiği ve doğayla iç içe vakit geçirebildiği ferah bir eğitim ortamı sunuyoruz. Bahçeleri yıllar içinde kendimiz kurduk: ahşap oyun mutfağı, açık hava sınıfı, denge yolu, dev satranç tahtası ve ağacın etrafındaki oturma bankı. Çocuklar günün büyük bölümünü burada geçiriyor.</p><a href="/gunluk-akis" class="inline-block rounded-full bg-grape px-6 py-3 font-semibold text-white shadow-lg shadow-grape/30 transition-colors duration-200 hover:bg-ink">Bir günümüzü görün</a></div></div><div class="my-16 text-center md:hidden"><img alt="Bahçedeki ahşap oyun mutfağı: tencereler, kepçeler ve kara tahta" loading="lazy" width="300" height="200" decoding="async" data-nimg="1" class="mx-auto rounded-3xl shadow-lg shadow-ink/10" style="color: transparent;" srcset="/_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=384&amp;q=75 1x, /_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=640&amp;q=75 2x" src="/_next/image?url=%2Fmutfak-atolyesi.webp&amp;w=640&amp;q=75"></div><div class="mt-16"><div class="flex flex-col items-center gap-8 md:flex-row md:gap-16"><div class="relative order-2 hidden md:block md:w-1/2 md:order-1"><div aria-hidden="true" class="absolute -z-10 left-0 bottom-0 h-3/4 w-3/4 rounded-full bg-bubble/40"></div><img alt="Bahçedeki ahşap mutfak atölyesi, açık hava sınıfı ve ağacı çevreleyen oturma bankı" loading="lazy" width="400" height="400" decoding="async" data-nimg="1" class="relative z-0 h-auto w-full max-w-md rounded-3xl object-cover shadow-lg shadow-ink/10" style="color: transparent;" srcset="/_next/image?url=%2Fbahce-atolyeler.webp&amp;w=640&amp;q=75 1x, /_next/image?url=%2Fbahce-atolyeler.webp&amp;w=828&amp;q=75 2x" src="/_next/image?url=%2Fbahce-atolyeler.webp&amp;w=828&amp;q=75"></div><div class="order-1 md:w-1/2 md:order-2"><h2 class="mb-4 font-display text-2xl text-ink md:text-3xl">Kadromuz ve sınıflarımız</h2><p class="mb-6 text-ink-soft">Kendi alanında deneyimli ve uzman bir eğitim kadrosuyla her çocuğun bireysel gelişimini yakından takip ediyoruz. Sınıflarımızı çocukların doğum yıllarını ve aylarını dikkate alarak oluşturuyor, gelişim dönemlerine uygun bir eğitim süreci planlıyoruz. Sınıflarımızda 13 çocuk ve iki öğretmen bulunuyor; branş derslerinin her biri alanında uzman bir öğretmenle yürüyor.</p><a href="/aktiviteler" class="inline-block rounded-full bg-grape px-6 py-3 font-semibold text-white shadow-lg shadow-grape/30 transition-colors duration-200 hover:bg-ink">Branş derslerimiz</a></div></div></div></div></div><section class="bg-paper-warm py-16"><div class="mx-auto max-w-3xl px-6"><div class="overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-rule"><div class="h-1.5 bg-sky"></div><div class="p-8 md:p-10"><h2 class="font-display text-2xl text-ink md:text-3xl">Okulumuzda uzman psikolog görev yapıyor</h2><p class="mt-5 text-lg text-ink">Okulumuzda görev yapan uzman psikoloğumuzla çocuklarımızın sosyal ve duygusal gelişimini de destekliyoruz. İhtiyaç hâlinde velilerimiz randevu oluşturarak uzman psikoloğumuzdan bireysel görüşme desteği alabiliyor.</p><p class="mt-4 text-ink-soft">Uyum dönemi, kardeş kıskançlığı, tuvalet eğitimi ya da uyku düzeni gibi başlıklarda evde ve okulda tutarlı bir yaklaşım kurmak için sizinle birlikte çalışıyoruz.</p></div></div></div></section><section class="py-16"><div class="container mx-auto px-4 md:px-6"><div class="mb-12 text-center"><h2 class="font-display text-3xl text-ink md:text-4xl">Değerlerimiz</h2><p class="mx-auto mt-4 max-w-2xl text-ink-soft">Sevgi, güven ve aidiyet duygusunu merkeze alan bir okul ortamı kurmaya çalışıyoruz. Montessori yaklaşımımız ve branş derslerimizle çocukların özgüvenlerini, yeteneklerini ve bağımsızlıklarını destekliyoruz.</p></div><div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4"><div class="card-lift rounded-3xl bg-white p-6 text-center shadow-sm ring-1 ring-rule"><div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-bubble-deep"><svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg></div><h3 class="mb-2 font-display text-xl text-ink">Sevgi</h3><p class="text-sm leading-relaxed text-ink-soft">Çocuğun kendini burada değerli hissetmesi, öğrenmenin ön koşulu. Her şeyden önce bunu kuruyoruz.</p></div><div class="card-lift rounded-3xl bg-white p-6 text-center shadow-sm ring-1 ring-rule"><div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-mint-deep"><svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div><h3 class="mb-2 font-display text-xl text-ink">Güven</h3><p class="text-sm leading-relaxed text-ink-soft">Çıkışta öğretmeni size günü anlatır, gün içinde merak ettiğinizde bakabilirsiniz. Anlatmadığımız bir şey olmuyor.</p></div><div class="card-lift rounded-3xl bg-white p-6 text-center shadow-sm ring-1 ring-rule"><div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-grape"><svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg></div><h3 class="mb-2 font-display text-xl text-ink">Aidiyet</h3><p class="text-sm leading-relaxed text-ink-soft">Çocuk kendi sınıfını, kendi öğretmenini ve kendi köşesini tanır. Yıl ortasında öğretmen değiştirmiyoruz.</p></div><div class="card-lift rounded-3xl bg-white p-6 text-center shadow-sm ring-1 ring-rule"><div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-tangerine-deep"><svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg></div><h3 class="mb-2 font-display text-xl text-ink">Bağımsızlık</h3><p class="text-sm leading-relaxed text-ink-soft">Montessori çalışmasının hedefi bu: çocuk kendi işini seçsin, kendi hızında bitirsin, yerine kaldırsın.</p></div></div></div></section><section class="bg-paper-warm py-16"><div class="mx-auto max-w-2xl px-6"><h2 class="text-center font-display text-3xl text-ink">Okulu gezmeye gelin</h2><p class="mt-4 text-center text-ink-soft">Haftanın 5 günü Montessori çalışıyoruz. Randevunuzu çalışma saatine alalım, sınıfı iş üstünde görün.</p><div class="mt-10 rounded-3xl bg-white p-6 shadow-lg shadow-ink/5 md:p-8"><form novalidate="" class="space-y-5"><input readonly="" type="hidden" value="" name="gclid"><input readonly="" type="hidden" value="" name="fbclid"><input readonly="" type="hidden" value="" name="fbc"><input readonly="" type="hidden" value="" name="fbp"><input readonly="" type="hidden" value="/" name="landingPath"><input readonly="" type="hidden" value="" name="utm_source"><input readonly="" type="hidden" value="" name="utm_medium"><input readonly="" type="hidden" value="" name="utm_campaign"><input readonly="" type="hidden" value="" name="utm_term"><input readonly="" type="hidden" value="" name="utm_content"><div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden"><label for="website">Web siteniz</label><input id="website" tabindex="-1" autocomplete="off" type="text" name="website"></div><div class="grid gap-5 md:grid-cols-2"><div><label for="parentName" class="mb-1.5 block text-sm font-semibold text-ink">Adınız</label><input id="parentName" autocomplete="name" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark" required="" name="parentName"></div><div><label for="phone" class="mb-1.5 block text-sm font-semibold text-ink">Telefon numaranız</label><input id="phone" inputmode="tel" autocomplete="tel" placeholder="05XX XXX XX XX" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark" required="" type="tel" name="phone"></div></div><label class="flex items-start gap-3 text-sm text-ink-soft"><input required="" class="mt-1 h-4 w-4" type="checkbox" name="kvkkConsent"><span><a href="/gizlilik" class="underline">KVKK Aydınlatma Metni</a>'ni okudum. Başvurum için aranmama ve başvuru bilgilerimin reklamlarımızın etkinliğini ölçmek amacıyla Google ile paylaşılmasına onay veriyorum.</span></label><button type="submit" class="w-full rounded-full bg-grape px-8 py-4 text-lg font-semibold text-white shadow-lg shadow-grape/30 transition hover:bg-ink disabled:opacity-60">Beni Arayın</button><p class="text-center text-sm text-ink-soft">Numaranızı bırakın, <strong>15 dakika</strong> içinde sizi arayalım.</p></form></div></div></section></div>"`;
