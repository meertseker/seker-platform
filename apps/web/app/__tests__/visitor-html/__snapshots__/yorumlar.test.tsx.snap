// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`yorumlar ziyaretçi HTML > düzenleme katmanından önceki hâliyle aynı 1`] = `"<div class="min-h-screen bg-paper"><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Ana Sayfa","item":"https://sekeranaokulu.com/"},{"@type":"ListItem","position":2,"name":"Veli Yorumları","item":"https://sekeranaokulu.com/veli-yorumlari"}]}</script><section class="band-sunny relative overflow-hidden pb-16 pt-14 md:pb-20 md:pt-20"><div aria-hidden="true" class="pointer-events-none absolute inset-0"><span class="confetti-float absolute left-[6%] top-8 h-16 w-16 rounded-full bg-sunny/25"></span><span class="confetti-float absolute right-[8%] top-6 h-24 w-24 rounded-full bg-bubble/20"></span><span class="confetti-float absolute right-[22%] bottom-12 h-10 w-10 rotate-12 rounded-xl bg-mint/25"></span><span class="confetti-float absolute left-[18%] bottom-10 h-8 w-8 rotate-45 rounded-md bg-sky/25"></span><span class="confetti-float absolute left-[46%] top-4 h-6 w-6 rounded-full bg-white/20"></span></div><div class="relative z-10 mx-auto max-w-3xl px-6 text-center"><p class="timecode text-white/70">Veli Yorumları</p><h1 class="mt-4 font-display text-3xl text-white md:text-5xl">Bizi seçen ailelerin deneyimi</h1><p class="mx-auto mt-5 max-w-2xl text-base text-white/85 md:text-lg">Beykent Büyükçekmece'de çocuğunuz için okul ararken en çok güvendiğiniz kaynak, hâlihazırda bizi tercih etmiş ailelerin deneyimidir.</p></div><div aria-hidden="true" class="absolute inset-x-0 bottom-0 scallop"></div></section><section class="mx-auto max-w-5xl px-6 py-16"><div class="grid gap-8 md:grid-cols-2"><figure class="card-lift relative rounded-3xl bg-white p-8 shadow-sm ring-1 ring-rule"><span aria-hidden="true" class="absolute -top-4 left-8 flex h-9 w-9 items-center justify-center rounded-full font-display text-xl text-white bg-grape">“</span><blockquote class="text-lg leading-relaxed text-ink">“Şu an 4 yaşında olan kızımız için 1,5 yıl içinde 3 farklı yer denedik. Daha köklü ve iyi olur diye kolej anaokuluna bile gönderdik. Sonunda burada karar kıldık.”</blockquote><figcaption class="mt-6 text-sm text-ink-soft"><span class="font-semibold text-ink">Emre</span> — Google yorumu · 4 yaş velisi<span class="block text-ink-soft">Google İşletme Profili</span></figcaption></figure><figure class="card-lift relative rounded-3xl bg-white p-8 shadow-sm ring-1 ring-rule"><span aria-hidden="true" class="absolute -top-4 left-8 flex h-9 w-9 items-center justify-center rounded-full font-display text-xl text-white bg-bubble-deep">“</span><blockquote class="text-lg leading-relaxed text-ink">“Şu an ortaokulda olan büyük kızımla 2012’de başlayan Şeker Akademi maceram, 2021’de küçük kızımla devam etti. Bu yıl o da mezun oluyor. Hiç pişman olmadım.”</blockquote><figcaption class="mt-6 text-sm text-ink-soft"><span class="font-semibold text-ink">Arzu Ö.</span> — Google yorumu · iki çocuğunu da gönderen veli<span class="block text-ink-soft">Google İşletme Profili</span></figcaption></figure><figure class="card-lift relative rounded-3xl bg-white p-8 shadow-sm ring-1 ring-rule"><span aria-hidden="true" class="absolute -top-4 left-8 flex h-9 w-9 items-center justify-center rounded-full font-display text-xl text-white bg-mint-deep">“</span><blockquote class="text-lg leading-relaxed text-ink">“Okul öncesi eğitimin kapsamlı olduğu, velinin neredeyse her an hem telefonla hem uygulamadan bilgilendirildiği, öğretmenlerin güler yüzlü olduğu beş yıldızlık bir okul.”</blockquote><figcaption class="mt-6 text-sm text-ink-soft"><span class="font-semibold text-ink">Ece P.</span> — Google yorumu<span class="block text-ink-soft">Google İşletme Profili</span></figcaption></figure><figure class="card-lift relative rounded-3xl bg-white p-8 shadow-sm ring-1 ring-rule"><span aria-hidden="true" class="absolute -top-4 left-8 flex h-9 w-9 items-center justify-center rounded-full font-display text-xl text-white bg-sunny-deep">“</span><blockquote class="text-lg leading-relaxed text-ink">“3 yılın sonunda akademik olarak branş derslerinde iyi olan, daha önemlisi kendini rahat ifade edebilen, hakkını arayan, hayvan seven, yemek seçmeyen, sosyal kurallara uyan bir çocuğum var.”</blockquote><figcaption class="mt-6 text-sm text-ink-soft"><span class="font-semibold text-ink">Yonca M.</span> — Google yorumu · 3 yıl sonunda<span class="block text-ink-soft">Google İşletme Profili</span></figcaption></figure><figure class="card-lift relative rounded-3xl bg-white p-8 shadow-sm ring-1 ring-rule"><span aria-hidden="true" class="absolute -top-4 left-8 flex h-9 w-9 items-center justify-center rounded-full font-display text-xl text-white bg-grape">“</span><blockquote class="text-lg leading-relaxed text-ink">“6 yaşındaki oğlum Şeker Akademi’ye iki yıl gidip mezun oldu. Şu an birinci sınıfta. Çocukların hem akademik hem davranışsal gelişimine çok büyük katkısı oluyor; ilkokula geçince etkisi açıkça görülüyor.”</blockquote><figcaption class="mt-6 text-sm text-ink-soft"><span class="font-semibold text-ink">Gizem K.Ç.</span> — Google yorumu · mezun velisi<span class="block text-ink-soft">Google İşletme Profili</span></figcaption></figure><figure class="card-lift relative rounded-3xl bg-white p-8 shadow-sm ring-1 ring-rule"><span aria-hidden="true" class="absolute -top-4 left-8 flex h-9 w-9 items-center justify-center rounded-full font-display text-xl text-white bg-bubble-deep">“</span><blockquote class="text-lg leading-relaxed text-ink">“Kızımızı okula vermeye karar verdiğimizde çok araştırdık, pek çok okul gezdik ve görüşmelerimizdeki samimiyeti düşünerek Şeker Akademi’de karar kıldık. Başta kaygılarımız vardı ama uyum sürecindeki uzman desteği bunları giderdi.”</blockquote><figcaption class="mt-6 text-sm text-ink-soft"><span class="font-semibold text-ink">İsmail A.</span> — Google yorumu · uyum süreci<span class="block text-ink-soft">Google İşletme Profili</span></figcaption></figure><figure class="card-lift relative rounded-3xl bg-white p-8 shadow-sm ring-1 ring-rule"><span aria-hidden="true" class="absolute -top-4 left-8 flex h-9 w-9 items-center justify-center rounded-full font-display text-xl text-white bg-mint-deep">“</span><blockquote class="text-lg leading-relaxed text-ink">“İki yıldır oğlumuzu bu okula gönderiyoruz ve çok memnunuz. Hem eğitim hem eğlence veren, kendinizi ailenin bir parçası gibi hissettiren bir okul.”</blockquote><figcaption class="mt-6 text-sm text-ink-soft"><span class="font-semibold text-ink">Serdar G.</span> — Google yorumu · 2 yıllık veli<span class="block text-ink-soft">Google İşletme Profili</span></figcaption></figure><figure class="card-lift relative rounded-3xl bg-white p-8 shadow-sm ring-1 ring-rule"><span aria-hidden="true" class="absolute -top-4 left-8 flex h-9 w-9 items-center justify-center rounded-full font-display text-xl text-white bg-sunny-deep">“</span><blockquote class="text-lg leading-relaxed text-ink">“Oğlum 3 yıl gitti. Çok araştırdım, ilçedeki her okulu gezdim. Çocuğunuzu gönül rahatlığıyla emanet edebileceğiniz bir okul. 16 branş dersini ve öğretmenlerini saymıyorum bile.”</blockquote><figcaption class="mt-6 text-sm text-ink-soft"><span class="font-semibold text-ink">Zeynep A.E.</span> — Google yorumu · 3 yıl gönderen veli<span class="block text-ink-soft">Google İşletme Profili</span></figcaption></figure><figure class="card-lift relative rounded-3xl bg-white p-8 shadow-sm ring-1 ring-rule"><span aria-hidden="true" class="absolute -top-4 left-8 flex h-9 w-9 items-center justify-center rounded-full font-display text-xl text-white bg-grape">“</span><blockquote class="text-lg leading-relaxed text-ink">“Önce büyük kızımızı Ecem öğretmene, sonra küçük kızımızı Beyza öğretmene emanet ettik. Çocuklarımız için sevgi ve ilgiyle kocaman, sıcacık bir ev oldular.”</blockquote><figcaption class="mt-6 text-sm text-ink-soft"><span class="font-semibold text-ink">Esra</span> — Google yorumu · iki çocuğunu da gönderen veli<span class="block text-ink-soft">Google İşletme Profili</span></figcaption></figure><figure class="card-lift relative rounded-3xl bg-white p-8 shadow-sm ring-1 ring-rule"><span aria-hidden="true" class="absolute -top-4 left-8 flex h-9 w-9 items-center justify-center rounded-full font-display text-xl text-white bg-bubble-deep">“</span><blockquote class="text-lg leading-relaxed text-ink">“Kızım iki yıldır gidiyor. Gözüm kapalı emanet ediyorum. Keşke ilkokulları da olsa, hiç ayrılmasak.”</blockquote><figcaption class="mt-6 text-sm text-ink-soft"><span class="font-semibold text-ink">Müge İ.</span> — Google yorumu · 2 yıllık veli<span class="block text-ink-soft">Google İşletme Profili</span></figcaption></figure></div></section><section class="bg-paper-warm py-16 text-center"><h2 class="font-display text-2xl text-ink">Şeker Anaokulu'nda veliyseniz deneyiminizi paylaşın</h2><p class="mx-auto mt-4 max-w-xl px-6 text-ink-soft">Google İşletme Profilimiz üzerinden bıraktığınız yorumlar diğer aileler için de yol gösterici oluyor.</p><a href="https://maps.google.com/?q=Cumhuriyet%20Mahallesi%2C%20Uluda%C4%9F%20Sokak%20No%3A6%20Beykent%2C%20B%C3%BCy%C3%BCk%C3%A7ekmece%2F%C4%B0stanbul" target="_blank" rel="noopener noreferrer" class="mt-8 inline-block rounded-full border-2 border-grape px-8 py-4 font-semibold text-grape transition hover:bg-grape hover:text-white">Google'da Yorum Bırakın</a></section></div>"`;
