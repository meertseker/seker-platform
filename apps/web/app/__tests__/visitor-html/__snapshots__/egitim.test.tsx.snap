// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`egitim ziyaretçi HTML > düzenleme katmanından önceki hâliyle aynı 1`] = `"<div class="min-h-screen bg-paper"><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Ana Sayfa","item":"https://sekeranaokulu.com/"},{"@type":"ListItem","position":2,"name":"Eğitim Yaklaşımımız","item":"https://sekeranaokulu.com/egitim-yaklasimimiz"}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Kaç yaş arası çocukları kabul ediyorsunuz?","acceptedAnswer":{"@type":"Answer","text":"2-6 yaş arası çocukları kabul ediyoruz. Dört grubumuz var: 2-3 yaş oyun grubu, 3-4 yaş, 4-5 yaş ve 5-6 yaş ilkokula hazırlık. Sınıflarımızı çocukların doğum yıllarını ve aylarını dikkate alarak oluşturuyor, gelişim dönemlerine uygun bir eğitim süreci planlıyoruz."}},{"@type":"Question","name":"Bir sınıfta kaç çocuk var?","acceptedAnswer":{"@type":"Answer","text":"Sınıflarımızda 13 çocuk var ve her sınıfta iki öğretmen birden görev yapıyor. Millî Eğitim yönetmeliği bu yaş grubunda öğretmen başına 20 çocuğa kadar izin veriyor; biz bunun belirgin biçimde altında kalmayı tercih ediyoruz. İkinci öğretmenin olması şu demek: bir çocuk ağladığında ya da tuvalete götürülmesi gerektiğinde sınıfın geri kalanı boşta kalmıyor."}},{"@type":"Question","name":"İngilizce eğitiminiz nasıl işliyor?","acceptedAnswer":{"@type":"Answer","text":"Çocuğunuz her gün 2 saatini İngilizce öğretmeniyle geçiriyor — haftada birkaç ders değil, her gün. İngilizce çalışmaları oyun, şarkı, hikâye ve günlük iletişimin içinden yürüyor. English Play Time ve English Kids Club etkinliklerinde dil ders masasından çıkıyor; Speaking çalışmalarında çocuk öğrendiği ifadeleri konuşurken kullanıyor. İngilizcenin yanında Almanca çalışmalarına da yer veriyoruz."}},{"@type":"Question","name":"Nasıl bir eğitim programı uyguluyorsunuz?","acceptedAnswer":{"@type":"Answer","text":"Montessori yaklaşımını merkeze alan, oyunun içinden ilerleyen bir program uyguluyoruz. Somut olarak şöyle işliyor: materyaller çocuğun boyundaki açık raflarda duruyor, çocuk ne çalışacağını kendi seçiyor, öğretmen araya girmeden gözlemliyor. Bunun üzerine branş derslerini ekliyoruz. Eğitim programımız çocukların zihinsel, sosyal, duygusal, fiziksel ve sanatsal gelişimlerini bir bütün olarak destekleyecek şekilde planlanıyor."}}]}</script><section class="band-grape relative overflow-hidden pb-16 pt-14 md:pb-20 md:pt-20"><div aria-hidden="true" class="pointer-events-none absolute inset-0"><span class="confetti-float absolute left-[6%] top-8 h-16 w-16 rounded-full bg-sunny/25"></span><span class="confetti-float absolute right-[8%] top-6 h-24 w-24 rounded-full bg-bubble/20"></span><span class="confetti-float absolute right-[22%] bottom-12 h-10 w-10 rotate-12 rounded-xl bg-mint/25"></span><span class="confetti-float absolute left-[18%] bottom-10 h-8 w-8 rotate-45 rounded-md bg-sky/25"></span><span class="confetti-float absolute left-[46%] top-4 h-6 w-6 rounded-full bg-white/20"></span></div><div class="relative z-10 mx-auto max-w-3xl px-6 text-center"><p class="timecode text-white/70">Montessori · Branş dersleri · 2 saat İngilizce</p><h1 class="mt-4 font-display text-3xl text-white md:text-5xl">Eğitim Yaklaşımımız</h1><p class="mx-auto mt-5 max-w-2xl text-base text-white/85 md:text-lg">Çocukların bireysel farklılıklarını ve ilgi alanlarını dikkate alan bir eğitim yaklaşımı benimsiyoruz. Programımız; zihinsel, sosyal, duygusal, fiziksel ve sanatsal gelişimi bir bütün olarak destekleyecek şekilde planlanıyor.</p></div><div aria-hidden="true" class="absolute inset-x-0 bottom-0 scallop"></div></section><section class="mx-auto max-w-3xl px-6 py-16"><div class="space-y-8"><div class="overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-rule"><div class="h-1.5 bg-grape"></div><div class="p-8 md:p-10"><h2 class="font-display text-2xl text-ink md:text-3xl">Montessori yaklaşımını nasıl uyguluyoruz?</h2><div class="mt-5 space-y-4 text-ink-soft"><p class="text-lg text-ink">Montessori eğitimi okulumuzda haftanın 5 günü uygulanıyor. Ayrı bir etkinlik saati değil; günün omurgası bu.</p><p>Materyaller çocuğun boyundaki açık raflarda duruyor. Çocuk günlük yaşam, duyusal çalışmalar, dil, matematik, dikkat ve konsantrasyon alanlarında özel olarak hazırlanmış materyallerle çalışıyor. Bir işi seçmek, bitirmek ve yerine kaldırmak onun sorumluluğunda.</p><p>Sınıflarımızda 13 çocuk ve iki öğretmen bulunuyor. Bu yaklaşımın gerçekten işlemesi buna bağlı: öğretmenin her çocuğun neyle ne kadar çalıştığını gözlemleyebilmesi gerekiyor. Kalabalık bir sınıfta Montessori sözde kalır.</p><p>Bu çalışmalarla özgüven, sorumluluk, el-göz koordinasyonu, problem çözme ve odaklanma becerilerinin gelişimini destekliyoruz.</p></div></div></div><div class="overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-rule"><div class="h-1.5 bg-bubble"></div><div class="p-8 md:p-10"><h2 class="font-display text-2xl text-ink md:text-3xl">Çocuk günü kendisi planlayabiliyor mu?</h2><div class="mt-5 space-y-4 text-ink-soft"><p class="text-lg text-ink">Evet. Gün, sabah çemberinde birlikte planlanır: kim ne çalışacak, hangi branş dersi var, bahçeye ne zaman çıkılacak.</p><p>High Scope programının "planla-yap-değerlendir" döngüsünü bu noktada kullanıyoruz. Çocuk günün başında ne yapacağını seçiyor, seçtiği işi gerçekleştiriyor ve gün sonunda öğretmeniyle birlikte değerlendiriyor. Yaş büyüdükçe planlama süresi ve karmaşıklığı artıyor.</p><p>Sonuç, yönergeyle değil kendi kararıyla harekete geçen bir çocuk. İlkokula geçişte en çok işe yarayan alışkanlıklardan biri bu.</p></div></div></div><div class="overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-rule"><div class="h-1.5 bg-sunny"></div><div class="p-8 md:p-10"><h2 class="font-display text-2xl text-ink md:text-3xl">Branş dersleri programın neresinde duruyor?</h2><div class="mt-5 space-y-4 text-ink-soft"><p class="text-lg text-ink">Branş dersleri eğlence molası değil, programın parçası. Her biri alanında uzman bir öğretmen tarafından yürütülüyor.</p><p>Programımızda şu çalışmalar yer alıyor: Montessori Eğitimi, Beceri &amp; Koordinasyon, Görsel Sanatlar, Seramik, Robotik &amp; Kodlama, İngilizce, Müzik &amp; Ritim, Bale &amp; Dans, Drama, Satranç, Matematik ve Fen Çalışmaları.</p><p>Bu genişliği bilerek koruyoruz. Bir çocuk satrançta açılırken bir başkası seramikte ya da dramada parlıyor; hangi çocuğun neyle açılacağını önceden bilemiyorsunuz. Programımız her birine eşit görünürlük veriyor.</p><p>Bu çalışmalarla yaratıcılık, özgüven, iletişim, sosyal beceri, problem çözme, motor gelişim ve kendini ifade etme becerilerini destekliyoruz.</p></div></div></div><div class="overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-rule"><div class="h-1.5 bg-mint"></div><div class="p-8 md:p-10"><h2 class="font-display text-2xl text-ink md:text-3xl">Yabancı dil eğitimi nasıl işliyor?</h2><div class="mt-5 space-y-4 text-ink-soft"><p class="text-lg text-ink">Çocukların erken yaşta yabancı dil ile tanışmasını önemsiyoruz. Çocuğunuz her gün 2 saatini İngilizce öğretmeniyle geçiriyor — haftada birkaç ders değil, her gün aynı saatte.</p><p>İngilizce çalışmaları oyun, şarkı, hikâye, etkinlik ve günlük iletişimin içinden yürüyor. Çocuk önce anlıyor, sonra tek kelimelerle karşılık veriyor, en sonunda cümle kuruyor. Aceleye getirmiyoruz.</p><p>İngilizcenin yanında Almanca çalışmalarına da yer veriyoruz.</p></div></div></div><div class="overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-rule"><div class="h-1.5 bg-sky"></div><div class="p-8 md:p-10"><h2 class="font-display text-2xl text-ink md:text-3xl">Teknoloji eğitim sürecine nasıl giriyor?</h2><div class="mt-5 space-y-4 text-ink-soft"><p class="text-lg text-ink">Öğrenme sürecini daha anlaşılır ve etkileşimli hâle getirmek için akıllı tahta uygulamasından yararlanıyoruz. Çocukların derse aktif katılım göstermeleri ve öğrendiklerini görsel ve işitsel materyallerle pekiştirmeleri destekleniyor.</p><p>Teknolojiyi yaş grubuna uygun ölçüde ve öğretmenin yönlendirmesiyle kullanıyoruz. Robotik &amp; Kodlama dersinde çocuklar manyetik lego setleri ve tabletlerle kendi robotlarını kuruyor, sonra hareketlerini kodluyor.</p><p>Amacımız ekran süresi eklemek değil; çocuğun neden-sonuç ilişkisi kurmasını, planlama yapmasını ve çözüm üretmesini desteklemek.</p></div></div></div><div class="overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-rule"><div class="h-1.5 bg-grape"></div><div class="p-8 md:p-10"><h2 class="font-display text-2xl text-ink md:text-3xl">Sosyal ve duygusal gelişimi kim takip ediyor?</h2><div class="mt-5 space-y-4 text-ink-soft"><p class="text-lg text-ink">Okulumuzda görev yapan uzman psikoloğumuzla çocuklarımızın sosyal ve duygusal gelişimini de destekliyoruz. İhtiyaç hâlinde velilerimiz randevu oluşturarak uzman psikoloğumuzdan bireysel görüşme desteği alabiliyor.</p><p>Uyum dönemi, kardeş kıskançlığı, tuvalet eğitimi ya da uyku düzeni gibi başlıklarda evde ve okulda tutarlı bir yaklaşım kurmak için sizinle birlikte çalışıyoruz.</p><p>Sevgi, güven ve aidiyet duygusunu merkeze alan bir okul ortamı kurmaya çalışıyoruz. Çocuğun kendini burada değerli hissetmesi, öğrenmenin ön koşulu.</p></div></div></div></div></section><section class="bg-paper-warm py-16"><div class="mx-auto max-w-4xl px-6"><h2 class="text-center font-display text-3xl text-ink">İngilizce günün içinde nasıl görünüyor?</h2><div class="mt-10 grid gap-6 md:grid-cols-3"><div class="card-lift rounded-3xl bg-white p-6 shadow-sm"><h3 class="font-display text-xl text-ink">English Play Time</h3><p class="mt-3 text-sm leading-relaxed text-ink-soft">Çocuklar İngilizceyi yalnızca ders ortamında değil, oyun ve eğlence aracılığıyla da deneyimler. Oyun temelli çalışmalarla günlük kelime ve ifadeler pekişir.</p></div><div class="card-lift rounded-3xl bg-white p-6 shadow-sm"><h3 class="font-display text-xl text-ink">English Kids Club</h3><p class="mt-3 text-sm leading-relaxed text-ink-soft">Şarkılar, oyunlar, hikâyeler ve farklı iletişim çalışmalarıyla çocukların İngilizceye olan ilgisini artırmayı amaçlayan etkinliklerden oluşur.</p></div><div class="card-lift rounded-3xl bg-white p-6 shadow-sm"><h3 class="font-display text-xl text-ink">Speaking</h3><p class="mt-3 text-sm leading-relaxed text-ink-soft">Öğrendikleri kelime ve ifadeleri günlük iletişim içinde kullanmaları desteklenir; konuşma konusunda özgüven kazanmaları hedeflenir.</p></div></div></div></section><section class="mx-auto max-w-4xl px-6 py-16"><h2 class="text-center font-display text-3xl text-ink">Yaş grubuna göre program</h2><div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4"><a class="card-lift rounded-3xl bg-white p-6 text-center shadow-sm" href="/yas-gruplari/2-3-yas"><p class="font-display text-2xl text-bubble-deep">2-3 yaş</p><p class="mt-2 text-sm text-ink-soft">Oyun Grubu</p></a><a class="card-lift rounded-3xl bg-white p-6 text-center shadow-sm" href="/yas-gruplari/3-4-yas"><p class="font-display text-2xl text-sunny-deep">3-4 yaş</p><p class="mt-2 text-sm text-ink-soft">Anaokulu</p></a><a class="card-lift rounded-3xl bg-white p-6 text-center shadow-sm" href="/yas-gruplari/4-5-yas"><p class="font-display text-2xl text-mint-deep">4-5 yaş</p><p class="mt-2 text-sm text-ink-soft">Anaokulu</p></a><a class="card-lift rounded-3xl bg-white p-6 text-center shadow-sm" href="/yas-gruplari/5-6-yas"><p class="font-display text-2xl text-sky-deep">5-6 yaş</p><p class="mt-2 text-sm text-ink-soft">İlkokula Hazırlık</p></a></div><p class="mx-auto mt-8 max-w-2xl text-center text-ink-soft">Tam gün 07:30–18:30, yarım gün 07:30–13:00. 2011'den beri, 15 yıldır aynı yaklaşımla Beykent, Beylikdüzü, Mimaroba ve çevresindeki ailelere hizmet veriyoruz.</p></section><section class="mx-auto max-w-2xl px-6 pb-16"><h2 class="text-center font-display text-3xl text-ink">Programı yerinde görmek ister misiniz?</h2><p class="mt-4 text-center text-ink-soft">Ders saatinde gelin; sınıfları gezip öğretmenlerimizle tanışın.</p><div class="mt-10 rounded-3xl bg-white p-6 shadow-lg shadow-ink/5 ring-1 ring-rule md:p-8"><form novalidate="" class="space-y-5"><input readonly="" type="hidden" value="" name="gclid"><input readonly="" type="hidden" value="" name="fbclid"><input readonly="" type="hidden" value="" name="fbc"><input readonly="" type="hidden" value="" name="fbp"><input readonly="" type="hidden" value="/" name="landingPath"><input readonly="" type="hidden" value="" name="utm_source"><input readonly="" type="hidden" value="" name="utm_medium"><input readonly="" type="hidden" value="" name="utm_campaign"><input readonly="" type="hidden" value="" name="utm_term"><input readonly="" type="hidden" value="" name="utm_content"><div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden"><label for="website">Web siteniz</label><input id="website" tabindex="-1" autocomplete="off" type="text" name="website"></div><div class="grid gap-5 md:grid-cols-2"><div><label for="parentName" class="mb-1.5 block text-sm font-semibold text-ink">Adınız</label><input id="parentName" autocomplete="name" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark" required="" name="parentName"></div><div><label for="phone" class="mb-1.5 block text-sm font-semibold text-ink">Telefon numaranız</label><input id="phone" inputmode="tel" autocomplete="tel" placeholder="05XX XXX XX XX" class="w-full rounded-xl border-2 border-rule bg-white px-4 py-3 text-ink placeholder:text-ink-soft transition-colors focus:border-mark focus:outline-none focus:ring-1 focus:ring-mark" required="" type="tel" name="phone"></div></div><label class="flex items-start gap-3 text-sm text-ink-soft"><input required="" class="mt-1 h-4 w-4" type="checkbox" name="kvkkConsent"><span><a href="/gizlilik" class="underline">KVKK Aydınlatma Metni</a>'ni okudum. Başvurum için aranmama ve başvuru bilgilerimin reklamlarımızın etkinliğini ölçmek amacıyla Google ile paylaşılmasına onay veriyorum.</span></label><button type="submit" class="w-full rounded-full bg-grape px-8 py-4 text-lg font-semibold text-white shadow-lg shadow-grape/30 transition hover:bg-ink disabled:opacity-60">Beni Arayın</button><p class="text-center text-sm text-ink-soft">Numaranızı bırakın, <strong>15 dakika</strong> içinde sizi arayalım.</p></form></div></section></div>"`;
