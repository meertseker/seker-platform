exports[`yorumlar (boş durum) ziyaretçi HTML > düzenleme katmanından önceki hâliyle aynı 1`] = `"<div class="min-h-screen bg-paper"><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Ana Sayfa","item":"https://sekeranaokulu.com/"},{"@type":"ListItem","position":2,"name":"Veli Yorumları","item":"https://sekeranaokulu.com/veli-yorumlari"}]}</script><section class="band-sunny relative overflow-hidden pb-16 pt-14 md:pb-20 md:pt-20"><div aria-hidden="true" class="pointer-events-none absolute inset-0"><span class="confetti-float absolute left-[6%] top-8 h-16 w-16 rounded-full bg-sunny/25"></span><span class="confetti-float absolute right-[8%] top-6 h-24 w-24 rounded-full bg-bubble/20"></span><span class="confetti-float absolute right-[22%] bottom-12 h-10 w-10 rotate-12 rounded-xl bg-mint/25"></span><span class="confetti-float absolute left-[18%] bottom-10 h-8 w-8 rotate-45 rounded-md bg-sky/25"></span><span class="confetti-float absolute left-[46%] top-4 h-6 w-6 rounded-full bg-white/20"></span></div><div class="relative z-10 mx-auto max-w-3xl px-6 text-center"><p class="timecode text-white/70">Veli Yorumları</p><h1 class="mt-4 font-display text-3xl text-white md:text-5xl">Bizi seçen ailelerin deneyimi</h1><p class="mx-auto mt-5 max-w-2xl text-base text-white/85 md:text-lg">Beykent Büyükçekmece'de çocuğunuz için okul ararken en çok güvendiğiniz kaynak, hâlihazırda bizi tercih etmiş ailelerin deneyimidir.</p></div><div aria-hidden="true" class="absolute inset-x-0 bottom-0 scallop"></div></section><section class="mx-auto max-w-2xl px-6 py-16 text-center"><div class="overflow-hidden rounded-3xl bg-white shadow-lg shadow-ink/5"><div aria-hidden="true" class="grid h-2 grid-cols-4"><span class="bg-grape"></span><span class="bg-bubble"></span><span class="bg-sunny"></span><span class="bg-mint"></span></div><div class="p-10"><p class="font-display text-2xl text-ink">Veli yorumlarımızı burada topluyoruz.</p><p class="mt-4 text-ink-soft">Yorumları yalnızca velilerimizden yazılı onay aldıktan sonra yayımlıyoruz; bu sayfa yakında dolacak. Bu arada en güvenilir bilgi kaynağı okulumuzu bizzat görmek — sınıfları ve öğretmenlerimizle tanışmak için bir ziyaret planlayalım.</p><a href="/kayit" class="mt-8 inline-block rounded-full bg-grape px-8 py-4 font-semibold text-white shadow-lg shadow-grape/30 transition hover:bg-ink">Okul Ziyareti Planlayın</a></div></div></section><section class="bg-paper-warm py-16 text-center"><h2 class="font-display text-2xl text-ink">Şeker Anaokulu'nda veliyseniz deneyiminizi paylaşın</h2><p class="mx-auto mt-4 max-w-xl px-6 text-ink-soft">Google İşletme Profilimiz üzerinden bıraktığınız yorumlar diğer aileler için de yol gösterici oluyor.</p><a href="https://maps.google.com/?q=Cumhuriyet%20Mahallesi%2C%20Uluda%C4%9F%20Sokak%20No%3A6%20Beykent%2C%20B%C3%BCy%C3%BCk%C3%A7ekmece%2F%C4%B0stanbul" target="_blank" rel="noopener noreferrer" class="mt-8 inline-block rounded-full border-2 border-grape px-8 py-4 font-semibold text-grape transition hover:bg-grape hover:text-white">Google'da Yorum Bırakın</a></section></div>"`;
